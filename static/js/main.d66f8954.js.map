export default "{\"doc\":\"// util\\nfunction range(lo, hi) {\\n\\tif (hi == null) {\\n\\t\\thi = lo\\n\\t\\tlo = 0\\n\\t}\\t\\n\\tvar arr = []\\n\\tfor (var i = lo; i < hi; i++) {\\n\\t\\tarr.push(i)\\n\\t}\\n\\treturn arr\\n}\\nfunction shuffle(array) {\\n  let currentIndex = array.length,  randomIndex;\\n\\n  // While there remain elements to shuffle.\\n  while (currentIndex > 0) {\\n  \\n      // Pick a remaining element.\\n      randomIndex = Math.floor(Math.random() * currentIndex);\\n      currentIndex--;\\n  \\n      // And swap it with the current element.\\n      [array[currentIndex], array[randomIndex]] = [\\n      array[randomIndex], array[currentIndex]];\\n  }\\n\\n  return array;\\n}\\nfunction reversed(l) {\\n\\tvar rl = []\\n\\tfor (var i = l.length-1; i >= 0; i--)\\n\\t\\trl.push(l[i])\\n\\treturn rl\\n}\\n\\n// constants\\nconst WIDTH = 30\\nconst HEIGHT = 30\\nconst TYPES = ['BLANK', 'NUMBER', 'OPERATOR', 'EQUALS']\\nconst AXES = ['HORIZONTAL', 'VERTICAL']\\nconst POSITIONS = ['A', 'B', 'C']\\nconst DIR = ['UP', 'DOWN', 'LEFT', 'RIGHT']\\nconst OPERATORS = ['+', '-', '*', '/']\\n\\nfunction emptyCell(x,y) {\\n    return {\\n        x: x,\\n        y: y,\\n        type: 'BLANK',\\n        axes: {}\\n    }\\n}\\nfunction inGrid(x,y) {\\n    return x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT\\n}\\nfunction cellAt(x,y) {\\n    if (inGrid(x,y))\\n        return grid[y][x]\\n    return emptyCell(x,y)\\n}\\n\\n// create empty grid\\nvar grid = range(HEIGHT).map(y => {\\n    return range(WIDTH).map(x => emptyCell(x,y))\\n})\\nvar positions = []\\nrange(HEIGHT).map(y => {\\n    range(WIDTH).map(x => {\\n        positions.push({x:x, y:y})\\n    })\\n})\\n        \\nfunction validAPositionsRelativeToStatement(s) {\\n    var deltas = []\\n    if (s.axis == 'HORIZONTAL') {\\n        deltas = [\\n            {x:0, y:0},\\n            {x:2, y:0},\\n            {x:4, y:0},\\n            {x:0, y:2},\\n            {x:2, y:2},\\n            {x:4, y:2},\\n            {x:0, y:4},\\n            {x:2, y:4},\\n            {x:4, y:4},\\n        ]\\n    }\\n    else if (s.axis == 'VERTICAL') {\\n        deltas = [\\n            {x:0, y:0},\\n            {x:-2, y:0},\\n            {x:-4, y:0},\\n            {x:0, y:-2},\\n            {x:-2, y:-2},\\n            {x:-4, y:-2},\\n            {x:0, y:-4},\\n            {x:-2, y:-4},\\n            {x:-4, y:-4},\\n        ]\\n    }\\n    return deltas.map(e => {\\n       return {x: s.aPos.x+e.x, y: s.aPos.y+e.y}\\n    })\\n}\\nfunction verticalStatementsIntersect(sv1, sv2) {\\n    return sv1.aPos.x == sv2.aPos.x &&\\n           Math.abs(sv1.aPos.y-sv2.aPos.y) < 5\\n}\\nfunction horizontalStatementsIntersect(sh1, sh2) {\\n    return sh1.aPos.y == sh2.aPos.y &&\\n           Math.abs(sh1.aPos.x-sh2.aPos.x) < 5\\n}\\nfunction makeStatement(aPos,axis) {\\n    shuffle(OPERATORS)\\n    var op = OPERATORS[0]\\n    return {\\n        aPos: aPos,\\n        axis: axis,\\n        a: null,\\n        b: null,\\n        c: null,\\n        op: op\\n    }\\n}\\n\\n// create topology\\nvar statements = []\\nstatements.push(makeStatement({x:10,y:10}, 'HORIZONTAL'))\\nfor (var i = 0; i < 100000; i++) {\\n    var valid = true\\n    \\n    // pick random statement to branch off\\n    shuffle(statements)\\n    for (var g = 0; g < statements.length; g++) {\\n        var startStatement = statements[g]\\n        var axis = startStatement.axis == 'HORIZONTAL' ? 'VERTICAL' : 'HORIZONTAL'\\n        var statement = null\\n        var validPositionsRelativeToStartStatement = validAPositionsRelativeToStatement(startStatement)\\n        shuffle(validPositionsRelativeToStartStatement)\\n        for (var j = 0; j < validPositionsRelativeToStartStatement.length; j++) {\\n            var aPos = validPositionsRelativeToStartStatement.shift()\\n            statement = makeStatement(aPos, axis)\\n        \\n            // ensure statement doesn't intersect with statements of the same axis\\n            var statementsOfSameAxis = statements.filter(e => e.axis == axis)\\n            for (var k = 0; k < statementsOfSameAxis.length; k++) {\\n                var e = statementsOfSameAxis[k]\\n                if (axis == 'HORIZONTAL') {\\n                    if (horizontalStatementsIntersect(e,statement)) {\\n                        valid = false\\n                        break\\n                    }\\n                }\\n                else {\\n                    if (verticalStatementsIntersect(e,statement)) {\\n                        valid = false\\n                        break\\n                    }\\n                }\\n            }\\n    \\n            // statement intersected in an invalid way\\n            if (!valid)\\n                break\\n        }\\n\\n        // statement fits\\n        if (valid) {\\n            statements.push(statement)\\n            break\\n        }\\n    }\\n}\\n\\nfunction renderToGrid() {\\n    for (var i = 0; i < statements.length; i++) {\\n        var statement = statements[i]\\n        var aPos = statement.aPos\\n        var isHorizontal = statement.axis == 'HORIZONTAL'\\n        var dx = isHorizontal ? 1 : 0\\n        var dy = isHorizontal ? 0 : -1\\n        for (var j = 0; j < 5; j++) {\\n            var x = aPos.x+dx*j\\n            var y = aPos.y+dy*j\\n            var cell = cellAt(x,y)\\n            \\n            var type = 'BLANK'\\n            if (j == 0) {\\n                type = 'NUMBER'\\n                // cell.num = statement.a\\n            }\\n            else if (j == 1) {\\n                type = 'OPERATOR'\\n                cell.op = statement.op\\n            }\\n            else if (j == 2) {\\n                type = 'NUMBER'\\n                // cell.num = statement.b\\n            }\\n            else if (j == 3) type = 'EQUALS'\\n            else if (j == 4) {\\n                type = 'NUMBER'\\n                // cell.num = statement.c\\n            }\\n            cell.type = type\\n        }\\n    }\\n}\\nfunction displayNum(num) {\\n    if (num < 10)\\n        return ' '+num\\n    return ''+num\\n}\\nfunction toCSV(grid) {\\n    // util\\n    const rowIsEmpty = (row) => row.every(cell => cell.type == 'BLANK')\\n    const transpose = (grid) => grid[0].map((_, colIndex) => grid.map(row => row[colIndex]))\\n    const trimFront = (grid) => {\\n        const trimmed = []\\n        var hitNonEmpty = false\\n        for (var i = 0; i < grid.length; i++) {\\n            const row = grid[i]\\n            const empty = rowIsEmpty(row)\\n            if (!hitNonEmpty && empty)\\n                continue\\n            if (!hitNonEmpty && !empty)\\n                hitNonEmpty = true\\n            if (hitNonEmpty)\\n                trimmed.push(row)\\n        }\\n        return trimmed\\n    }\\n\\n    // trim edges\\n    var trimmedGrid = trimFront(grid)                   // trim left\\n    trimmedGrid = trimFront(reversed(trimmedGrid))      // trim right\\n    trimmedGrid = transpose(trimmedGrid)                // rotate\\n    trimmedGrid = trimFront(trimmedGrid)                // trim left\\n    trimmedGrid = trimFront(reversed(trimmedGrid))      // trim right\\n\\n    // to csv\\n    var text = reversed(trimmedGrid).map(row => {\\n        return row.map(cell => {\\n            if (cell.type == 'NUMBER')\\n                return cell.num\\n            else if (cell.type == 'OPERATOR') {\\n                if (cell.op == '/')\\n                    return '÷'\\n                else if (cell.op == '*')\\n                    return '×'\\n                return cell.op\\n            }\\n            else if (cell.type == 'EQUALS')\\n                return '='\\n        }).join(',')\\n    }).join('\\\\n')\\n    return text\\n}\\nasync function generate(allDistinct) {\\n    function getNumberIdent(statement, position) {\\n        var aPos = statement.aPos\\n        var isHorizontal = statement.axis == 'HORIZONTAL'\\n        var dx = isHorizontal ? 1 : 0\\n        var dy = isHorizontal ? 0 : -1\\n        var positions = ['a', 'b', 'c']\\n        var offsets = [0, 2, 4]\\n        var offset = offsets[positions.indexOf(position)]\\n        var pos = {x: aPos.x+dx*offset, y: aPos.y+dy*offset}\\n        return 'N_'+pos.x+'_'+pos.y\\n    }\\n\\n    var allIdents = []\\n    range(HEIGHT).map(y => {\\n        range(WIDTH).map(x => {\\n            var cell = cellAt(x,y)\\n            if (cell.type == 'NUMBER')\\n                allIdents.push('N_'+x+'_'+y)\\n        })\\n    })\\n    var predicates = ['plus', 'minus', 'mult', 'div']\\n    var ops = ['+', '-', '*', '/']\\n    var prologInput = `Vars = [${allIdents.join(',\\\\n        ')}],\\\\n\\\\n`+\\n        statements.map(s => {\\n            var pred = predicates[ops.indexOf(s.op)]\\n            return `${pred}(${getNumberIdent(s,'a')}, ${getNumberIdent(s,'b')}, ${getNumberIdent(s,'c')})`\\n        }).join(',\\\\n')\\n        + ','\\n        + (allDistinct ? '\\\\n\\\\nall_distinct(Vars),' : '\\\\n\\\\n% all_distinct(Vars),')\\n        + '\\\\n\\\\nlabel(Vars).'\\n\\n    // set output\\n    output = prologInput\\n\\n    // run prolog\\n    runProlog(prolog, prologInput, (prologOutput, err) => {\\n      if (err) {\\n        async_set('grid', err, true)\\n        return\\n      }\\n      \\n      const definitions = allIdents.map(ident => {\\n          const value = prologOutput[ident]\\n          const identParts = ident.split('_')\\n          var x = parseInt(identParts[1])\\n          var y = parseInt(identParts[2])\\n          return {x:x, y:y, value:value}\\n      })\\n\\n      // update cells with number values\\n      definitions.map(def => {\\n          var cell = cellAt(def.x,def.y)\\n          cell.num = def.value\\n      })\\n\\n      // update grid\\n      renderToGrid()\\n\\n      // set csv\\n      const lvlcsv = toCSV(grid, 0.5)\\n      async_set('grid', lvlcsv)\\n    })\\n}\\n\\n// populate symbols\\nrenderToGrid()\\n\\n// populate numbers\\nconst allDistinct = true\\ngenerate(allDistinct)\",\"selection\":{\"ranges\":[{\"anchor\":9209,\"head\":9209}],\"main\":0},\"fold\":[32,151,178,596,620,700,990,1078,1102,1158,1182,1256,1315,1365,1411,1482,1542,2233,2283,2370,2422,2509,2546,2721,2855,4474,4502,5501,5529,5589,5613,7137,7177,9126,7228,7629]}";