export default "{\"doc\":\"using System.Collections.Generic;\\nusing UnityEngine;\\nusing UnityEngine.UI;\\nusing TMPro;\\n\\npublic class Skill : MonoBehaviour {\\n    public string name;\\n    public int cost;\\n    public bool purchased;\\n    public bool unlocked;\\n    public List<Skill> next;\\n\\n    ///////\\n    // UTIL\\n    ///////\\n    void UpdateUI() {\\n        transform.GetChild(0).gameObject.GetComponent<TMP_Text>().text = name;\\n        transform.GetChild(1).gameObject.GetComponent<TMP_Text>().text = $\\\" ${cost}\\\";\\n        transform.GetChild(1).gameObject.SetActive(!purchased);\\n        GetComponent<Image>().color = purchased ? Color.green : Color.white;   \\n        GetComponent<Button>().interactable = unlocked;\\n        GetComponent<Button>().enabled = !purchased;\\n    }\\n\\n    /////////\\n    // PUBLIC\\n    /////////\\n    public void Enable(bool enabled) {\\n        unlocked = enabled;\\n        UpdateUI();\\n    }\\n    public void Purchase() {\\n        purchased = true;\\n        ES3.SaveBool($\\\"{name}_purchased\\\", true);\\n        UpdateUI();\\n    }\\n    public void Reset() {\\n        purchased = false;\\n        unlocked = false;\\n        ES3.SaveBool($\\\"{name}_purchased\\\", false);\\n    }\\n    \\n    ///////////////\\n    // UNITY EVENTS\\n    ///////////////\\n    void OnClick() {\\n        SkillTree st = transform.parent.gameObject.GetComponent<SkillTree>();\\n        st.ShowConfirmation(this);\\n    }\\n    void Awake() {\\n        GetComponent<Button>().onClick.AddListener(OnClick);\\n        purchased = ES3.LoadBool($\\\"{name}_purchased\\\", false);\\n        UpdateUI();\\n    }\\n}\",\"selection\":{\"ranges\":[{\"anchor\":1346,\"head\":1346}],\"main\":0},\"fold\":[]}";