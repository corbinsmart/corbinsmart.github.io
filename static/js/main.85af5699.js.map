export default "{\"doc\":\"using System.Linq;\\nusing System.Collections;\\nusing System.Collections.Generic;\\nusing UnityEngine;\\nusing UnityEngine.UI;\\nusing UnityEngine.SceneManagement;\\nusing TMPro;\\n\\npublic static class ES3 {\\n    public static bool LoadBool(string key, bool defaultValue) {\\n        return PlayerPrefs.GetInt(key, defaultValue ? 1 : 0) == 1;\\n    }\\n    public static int LoadInt(string key, int defaultValue) {\\n        return PlayerPrefs.GetInt(key, defaultValue);\\n    }\\n    public static void SaveBool(string key, bool value) {\\n        PlayerPrefs.SetInt(key, value ? 1 : 0);\\n    }\\n    public static void SaveInt(string key, int value) {\\n        PlayerPrefs.SetInt(key, value);\\n    }\\n}\\n\\npublic class SkillTree : MonoBehaviour {\\n    [Header(\\\"UI\\\")]\\n    public Player player;\\n    public GameObject linesContainer;\\n    public GameObject line;\\n    public GameObject confirmationPane;\\n    public GameObject confirmationModal;\\n    public TMP_Text skillPointCountText;\\n    public TMP_Text confirmationTitle;\\n    public TMP_Text confirmationSkillName;\\n    public TMP_Text confirmationSkillCost;\\n    public Button confirmationBuyButton;\\n    public Color limeGreen;\\n\\n    ////////\\n    // STATE\\n    ////////\\n    [Header(\\\"State\\\")]\\n    public bool execInEditor;\\n    public int skillPointCount = initPointCount;\\n    const int initPointCount = 999;\\n    static List<Skill> skills = new();\\n    List<GameObject> lines = new();\\n    List<string> skillNames;\\n    Skill selectedSkill;\\n\\n    /////////\\n    // PUBLIC\\n    /////////\\n    public static bool Has(string skillName) {\\n        return skills.Where(s => s.name.ToLower() == skillName.ToLower() && s.purchased).Count() > 0;\\n    }\\n    public void ShowConfirmation(Skill s) {\\n        selectedSkill = s;\\n        \\n        confirmationTitle.text = $\\\"Buy <b>[{s.name}]</b> for ${s.cost}?\\\";\\n        confirmationSkillName.text = s.name;\\n        confirmationSkillCost.text = $\\\" ${s.cost}\\\";\\n        confirmationBuyButton.interactable = skillPointCount >= s.cost;\\n        confirmationBuyButton.GetComponent<Image>().color = confirmationBuyButton.interactable ? limeGreen : Color.white;\\n        confirmationBuyButton.GetComponentInChildren<TMP_Text>().color = confirmationBuyButton.interactable ? Color.black : Color.black.a(0.5f);\\n        confirmationPane.SetActive(true);\\n        confirmationModal.SetActive(true);\\n    }\\n    public void BuySkill() {\\n        if (skillPointCount < selectedSkill.cost || selectedSkill == null)\\n            return;\\n        \\n        selectedSkill.Purchase();\\n        skillPointCount -= selectedSkill.cost;\\n        ES3.SaveInt(\\\"skillPointCount\\\", skillPointCount);\\n\\n        selectedSkill = null;\\n        UpdateTree();\\n        HideConfirmation();\\n    }\\n    public void HideConfirmation() {\\n        confirmationPane.SetActive(false);\\n        confirmationModal.SetActive(false);\\n    }\\n    public void Reset() {\\n        skills.ForEach(s => s.Reset());\\n\\n        ES3.SaveInt(\\\"skillPointCount\\\", initPointCount);\\n        skillPointCount = initPointCount;\\n\\n        UpdateTree();\\n        player.Awake();\\n    }\\n\\n    ////////////\\n    // UTILITIES\\n    ////////////\\n    static Color GetSkillColor(Skill s) {\\n        if (s.purchased)\\n            return Color.green;\\n        if (s.unlocked)\\n            return Color.white;\\n        return Color.gray;\\n    }\\n    static List<Skill> GetRootSkills() {\\n        return skills.Where(s0 => skills.All(s1 => !s1.next.Contains(s0))).ToList();\\n    }\\n    void DrawLine(Skill s0, Skill s1) {\\n        // make line\\n        GameObject l = Instantiate(line);\\n        l.transform.SetParent(linesContainer.transform);\\n        l.SetActive(true);\\n        l.name = $\\\"{s0.name} -> {s1.name}\\\";\\n        lines.Add(l);\\n\\n        // set positions\\n        LineRenderer lr = l.GetComponent<LineRenderer>();\\n        lr.SetPosition(0, s0.gameObject.transform.position);\\n        lr.SetPosition(1, s1.gameObject.transform.position);\\n\\n        // set line colors\\n        lr.startColor = GetSkillColor(s0);\\n        lr.endColor = GetSkillColor(s1);\\n    }\\n    void DestroyLines() {\\n        lines.ForEach(l => DestroyImmediate(l));\\n        for (int i = linesContainer.transform.childCount-1; i >= 0; i--)\\n            DestroyImmediate(linesContainer.transform.GetChild(i).gameObject);\\n        lines.Clear();\\n    }\\n    void UpdateTree() {\\n        // skill points\\n        skillPointCountText.text = $\\\"${skillPointCount}\\\";\\n\\n        // destroy existing lines\\n        DestroyLines();\\n\\n        // draw lines between skills\\n        skills.ForEach(s0 => {\\n            s0.next.ForEach(s1 => {\\n                DrawLine(s0, s1);\\n            });\\n        });\\n\\n        // enable root nodes\\n        List<Skill> roots = GetRootSkills();\\n        skills.ForEach(s => s.Enable(false));\\n        roots.ForEach(s => s.Enable(true));\\n\\n        // enable all children of purchased nodes\\n        skills.ForEach(s0 => {\\n            if (s0.purchased)\\n                s0.next.ForEach(s1 => s1.Enable(true));\\n        });\\n    }\\n\\n    ///////////////\\n    // UNITY EVENTS\\n    ///////////////\\n    void Awake() {\\n        // get all skills\\n        gameObject.GetComponentsInChildren<Skill>(skills);\\n\\n        // reset lines\\n        DestroyLines();\\n\\n        // reset on first load\\n        if (!ES3.LoadBool(\\\"loaded\\\", false)) {\\n            ES3.SaveInt(\\\"skillPointCount\\\", initPointCount);\\n            skills.ForEach(s => s.Reset());\\n            ES3.SaveBool(\\\"loaded\\\", true);\\n        }\\n        \\n        // load skill point count\\n        skillPointCount = ES3.LoadInt(\\\"skillPointCount\\\", skillPointCount);\\n\\n        UpdateTree();\\n        player.Awake();\\n    }\\n    void Start() {\\n        UpdateTree();\\n    }\\n}\",\"selection\":{\"ranges\":[{\"anchor\":5541,\"head\":5541}],\"main\":0},\"fold\":[194,669,1535,1642,1687,2323,2353,2681,2719,2811,2838,3029,3124,3269,3311,3401,3442,3978,4005,4234,4259,4917]}";