export default "{\"doc\":\"using Jint;\\nusing Jint.Runtime;\\nusing Jint.Runtime.Interop;\\nusing System;\\nusing System.IO;\\nusing System.Linq;\\nusing System.Threading;\\nusing System.Collections;\\nusing System.Collections.Generic;\\nusing UnityEngine;\\nusing UnityEngine.Networking;\\nusing UnityEngine.SceneManagement;\\n\\n#if UNITY_EDITOR\\nusing UnityEditor;\\nusing NativeWebSocket;\\n#endif\\n\\nusing Newtonsoft.Json;\\n\\nusing v2 = UnityEngine.Vector2;\\nusing v3 = UnityEngine.Vector3;\\nusing Gob = UnityEngine.GameObject;\\nusing Body = UnityEngine.Rigidbody;\\n\\npublic class FileUpdate {\\n\\tpublic string file;\\n\\tpublic string text;\\n}\\npublic class ExecutionCancelledException : Exception {}\\nclass ThrottleConstraint : Jint.Constraint {\\n  jsrun runner;\\n  int runCounter = 0;\\n\\n  public ThrottleConstraint(jsrun j) {\\n    runner = j;\\n  }\\n  public override void Reset() {}\\n  public override void Check() {\\n    runner.GetMessages();\\n    if (runner.editCount > 1)\\n      throw new ExecutionCancelledException();\\n  }\\n}\\n\\npublic class jsrun : MonoPlus {\\n  [Header(\\\"Values\\\")]\\n  public bool serverEnabled;\\n  public float jsTimeout = 10f;\\n\\n  [Header(\\\"Objects\\\")]\\n  public Button devSettingsButton;\\n  public Button devSettingsCloseButton;\\n  public GameObject devSettingsPanel;\\n  public TMP_InputField serverAddressInput;\\n  public TMP_InputField serverPortInput;\\n  public TMP_InputField fileServerPortInput;\\n\\n  ////////\\n  // STATE\\n  ////////\\n  public static jsrun jsrunInstance;\\n  CancellationTokenSource cancelSource;\\n  Engine engine;\\n  #if UNITY_EDITOR\\n  WebSocket websocket;\\n  #endif\\n  Dictionary<string,string> codes;\\n  public bool editDirty = false;\\n  List<Gob> globalObjectPool = new();\\n  public int editCount = 0;\\n  FileUpdate latestUpdate;\\n  public string hotScenePath;\\n\\n  ////////////////\\n  // GAME SPECIFIC\\n  ////////////////\\n  HashSet<string> englishWords;\\n  void LoadEnglishWords() {\\n      string dictPath = \\\"dictionary/words_alpha\\\";\\n      string text = Resources.Load<TextAsset>(dictPath).text;\\n      List<string> words = text.Split(new string[] { \\\"\\\\r\\\\n\\\" }, StringSplitOptions.None).ToList();//text.Split('\\\\n').ToList();\\n      englishWords = new HashSet<string>(words);\\n      log(englishWords.Count);\\n  }\\n  public bool IsValidWord(string word) {\\n\\t\\treturn englishWords.Contains(word);\\n\\t}\\n\\n  ////////////\\n  // EVALUATOR\\n  ////////////\\n  public void InitEngine() {\\n      cancelSource = new CancellationTokenSource();\\n      engine = new Engine(options => {\\n          options.AddExtensionMethods(typeof(Vector3Extension));\\n          options.AddExtensionMethods(typeof(Vector2Extension));\\n          options.AddExtensionMethods(typeof(GameObjectExtension));\\n          options.AddExtensionMethods(typeof(ColorExtension));\\n          options.AllowClr();\\n          // options.CancellationToken(cancelSource.Token);\\n          options.TimeoutInterval(TimeSpan.FromSeconds(jsTimeout));\\n          options.Constraint(new ThrottleConstraint(this));\\n      });\\n      var types = new List<Type>() {\\n          typeof(SceneManager),\\n          typeof(Screen),\\n          typeof(Input),\\n          typeof(Time),\\n          typeof(Gob),\\n          typeof(Physics),\\n          typeof(Transform),\\n          typeof(Scene),\\n\\n          // enums\\n          typeof(PrimitiveType),\\n          typeof(TouchPhase),\\n          typeof(ForceMode),\\n          typeof(RuntimePlatform),\\n          typeof(CursorLockMode),\\n          typeof(Space),\\n          typeof(HapticStrength),\\n          typeof(KeyCode),\\n          typeof(FontStyle),\\n          typeof(Motion),\\n          typeof(RenderTextureFormat),\\n\\n          // components\\n          typeof(Camera),\\n          typeof(Mesh),\\n          typeof(MeshFilter),\\n          typeof(Color),\\n          typeof(Texture),\\n          typeof(Texture2D),\\n          typeof(Sprite),\\n          typeof(Material),\\n          typeof(MeshRenderer),\\n          typeof(SpriteRenderer),\\n          typeof(LineRenderer),\\n          typeof(Collider),\\n          typeof(BoxCollider),\\n          typeof(SphereCollider),\\n          typeof(CapsuleCollider),\\n          typeof(MeshCollider),\\n\\n          // ui components\\n          typeof(EventSystem),\\n          typeof(GraphicRaycaster),\\n          typeof(Image),\\n          typeof(RawImage),\\n          typeof(Slider),\\n\\n          // misc\\n          typeof(Quaternion),\\n          typeof(v3),\\n          typeof(v2),\\n          typeof(Ray),\\n          typeof(RaycastHit),\\n          typeof(Mathf),\\n          typeof(Debug),\\n          typeof(Application),\\n          typeof(Touch),\\n          typeof(LineUtility),\\n          typeof(Rect),\\n          typeof(Bounds),\\n          typeof(TextureFormat),\\n          typeof(RenderTexture),\\n          typeof(Cursor),\\n          typeof(VideoPlayer),\\n          typeof(Resources),\\n\\n          // custom\\n          typeof(jsrun),\\n          typeof(Util),\\n          typeof(Tool),\\n          typeof(Motion),\\n\\n          // 3rd party\\n          typeof(CatmullRom),\\n          typeof(PolygonColliderOptimizer),\\n          typeof(CollisionListener),\\n          typeof(MacTrackpad),\\n          typeof(MacTouchPhase),\\n\\n          // Editor\\n          #if UNITY_EDITOR\\n          typeof(SceneView),\\n          #endif\\n      };\\n\\n      types.ForEach(t => {\\n          string name = t.ToString().Split('.').Last();\\n          engine.SetValue(name, TypeReference.CreateTypeReference(engine, t));\\n      });\\n\\n      // cleanup\\n      engine.SetValue(\\\"globalObjectPool\\\", globalObjectPool);\\n\\n      engine.SetValue(\\\"V2List\\\", TypeReference.CreateTypeReference(engine, typeof(List<v2>)));\\n      engine.SetValue(\\\"V3List\\\", TypeReference.CreateTypeReference(engine, typeof(List<v3>)));\\n      engine.SetValue(\\\"Random\\\", TypeReference.CreateTypeReference(engine, typeof(UnityEngine.Random)));\\n\\n      engine.SetValue(\\\"o\\\", new Func<string,Gob>(name => o(name)));\\n      engine.SetValue(\\\"log\\\", new Action<object>(msg => log(msg)));\\n      engine.SetValue(\\\"Instantiate\\\", new Func<UnityEngine.Object, UnityEngine.Object>(o => Instantiate(o)));\\n      engine.SetValue(\\\"Destroy\\\", new Action<UnityEngine.Object>(o => Destroy(o)));\\n      engine.SetValue(\\\"Raycast\\\", new Func<Ray, float, int, _RaycastHit>((r,l,m) => Raycast(r,l,m)));\\n      engine.SetValue(\\\"GetCollision\\\", new Func<float, _Collision>((f) => CollisionMarshal.GetCollision(f)));\\n\\n      // app methods, app values\\n      engine.SetValue(\\\"AddButtonCallback\\\", new Action<Gob>((g) => AddButtonCallback(g)));\\n      engine.SetValue(\\\"MakeRenderTexture\\\", new Func<int,int,RenderTexture>((w,h) => new RenderTexture(w,h,16)));\\n      engine.SetValue(\\\"MakeBounds\\\", new Func<v3,v3,Bounds>((center,size) => new Bounds(center,size)));\\n      engine.SetValue(\\\"TestInt\\\", new Func<int,int>((i) => TestInt(i)));\\n      engine.SetValue(\\\"MakeTexture\\\", new Func<int,int,Texture2D>((w,h) => MakeTexture(w,h)));\\n      engine.SetValue(\\\"MakeSprite\\\", new Action<int>((_) => MakeSprite()));\\n\\n      // Words Game specific\\n      engine.SetValue(\\\"IsValidWord\\\", new Func<string,bool>((word) => IsValidWord(word)));\\n      engine.SetValue(\\\"Reload\\\", new Action<int>((x) => Reload()));\\n\\n      // resources\\n      engine.SetValue(\\\"LoadTexture2D\\\", new Func<string, UnityEngine.Texture2D>((path) => {\\n          var tex = Resources.Load<Texture2D>(path);\\n          return tex;\\n      }));\\n      engine.SetValue(\\\"LoadAsyncTexture2D\\\", new Action<string, OnLoadTexture2D>((path, cb) => {\\n          IEnumerator _() {\\n              var request = Resources.LoadAsync<Texture2D>(path);\\n              while (!request.isDone)\\n                  yield return null;\\n              if (cb != null)\\n                  cb((Texture2D)request.asset);\\n          }\\n          StartCoroutine(_());\\n      }));\\n  }\\n  void Execute(string code) {\\n      var body = \\\"\\\";\\n  try {\\n    body = code;\\n    engine.Execute(body);\\n  }\\n  catch (JavaScriptException ex) {\\n    Debug.LogError($\\\"{ex.Location} -- {ex.JavaScriptStackTrace} -- {ex.Error}\\\");\\n  }\\n      catch (ExecutionCancelledException ex) {\\n          throw new ExecutionCancelledException();\\n      }\\n  catch (Exception ex) {\\n    Debug.LogError($\\\"JS App Error: {ex.Message}\\\\n\\\");\\n  }\\n  }\\n  void QueueMessage(string msg) {\\n      FileUpdate update = JsonConvert.DeserializeObject<FileUpdate>(msg);\\n      latestUpdate = update;\\n      editCount++;\\n  }\\n  string ProcessCode(string code) {\\n      return code.Split(\\\"---\\\")[0];\\n  }\\n  void ProcessEdit() {\\n      GetMessages();\\n      if (editCount > 0) {\\n          string code = ProcessCode(latestUpdate.text);\\n          codes[latestUpdate.file] = code;\\n          Reload();\\n      }\\n      editCount = 0;\\n  }\\n  void LoadCodes() {\\n      string utilPath = \\\"js/src/util\\\";\\n      string mainPath = \\\"js/src/main\\\";\\n      codes = new Dictionary<string,string>() {\\n          {\\\"util\\\", ProcessCode(Resources.Load<TextAsset>(utilPath).text)},\\n          {\\\"main\\\", ProcessCode(Resources.Load<TextAsset>(mainPath).text)},\\n      };\\n  }\\n  public void Reload() {\\n      Cleanup();\\n      ClearLog();\\n      InitEngine();\\n  }\\n  void Cleanup() {\\n      foreach (var gob in globalObjectPool) {\\n          Destroy(gob);\\n      }\\n      globalObjectPool.Clear();\\n  }\\n\\n  /////////////////\\n  // HOTLOAD SERVER\\n  /////////////////\\n  void OnDevSettingsButton() {\\n    devSettingsPanel.On();\\n  }\\n  void OnDevSettingsCloseButton() {\\n    devSettingsPanel.Off();\\n  }\\n  void OnServerAddressChange(string addr) {\\n    Util.String(\\\"serverAddress\\\", addr);\\n    #if UNITY_EDITOR\\n    ConnectToServer();\\n    #endif\\n  }\\n  void OnServerPortChange(string port) {\\n    Util.String(\\\"serverPort\\\", port);\\n    #if UNITY_EDITOR\\n    ConnectToServer();\\n    #endif\\n  }\\n  void OnFileServerPortChange(string port) {\\n    Util.String(\\\"fileServerPort\\\", port);\\n  }\\n  #if UNITY_EDITOR\\n  async void ConnectToServer() {\\n    string addr = \\\"ws://\\\"+serverAddressInput.text+\\\":\\\"+serverPortInput.text;\\n    Log(\\\"ConnectToServer: \\\"+addr);\\n    websocket = new WebSocket(addr);\\n\\n    websocket.OnMessage += (bytes) => {\\n        string msg = System.Text.Encoding.UTF8.GetString(bytes);\\n        QueueMessage(msg);\\n    };\\n\\n    websocket.OnError += async (e) => {\\n        Debug.Log(\\\"Error! \\\" + e);\\n        await websocket.Close();\\n    };\\n\\n    websocket.OnOpen += () => {\\n        Log(\\\"Connection open! \\\" + websocket.State);\\n        CancelInvoke();\\n\\n        websocket.OnClose += (e) => {\\n            Log(\\\"Connection closed!\\\");\\n            InvokeRepeating(\\\"ConnectToServer\\\", 1f, 1f);\\n        };\\n    };\\n\\n    // waiting for messages\\n    await websocket.Connect();\\n  }\\n  #endif\\n  void Reconnect() {\\n    Log(\\\"reconnect\\\");\\n    websocket.Close();\\n    websocket.Connect();\\n  }\\n  async void OnDisconnect() {\\n    InvokeRepeating(\\\"TryReconnect\\\", 0f, 1f);\\n    await websocket.Close();\\n    Invoke(\\\"ConnectToServer\\\", 1f);\\n  }\\n  void TryReconnect() {\\n    if (websocket != null && websocket.State == WebSocketState.Open) {\\n      CancelInvoke();\\n      return;\\n    }\\n    Reconnect();\\n  }\\n  #if UNITY_EDITOR\\n  async void Send(string result) {\\n    if (websocket.State == WebSocketState.Open) {\\n      await websocket.SendText(result);\\n    }\\n  }\\n  async void OnApplicationQuit() {\\n    if (websocket != null)\\n      await websocket.Close();\\n  }\\n  #endif\\n  void GetMessages() {\\n    #if UNITY_EDITOR\\n    if (serverEnabled && websocket != null)\\n      websocket.DispatchMessageQueue();\\n    #endif\\n  }\\n\\n  ///////////////\\n  // UNITY EVENTS\\n  ///////////////\\n  public override void Init() {\\n    base.Init();\\n\\n    // Words Game specific\\n    LoadEnglishWords();\\n\\n    LoadCodes();\\n    InitEngine();\\n\\n    // dev settings\\n    #if UNITY_EDITOR\\n      string addr = \\\"localhost\\\";\\n    #else\\n      string addr = \\\"192.168.0.102\\\";\\n    #endif\\n    serverAddressInput.text = Util.GString(\\\"serverAddress\\\", addr);\\n    serverPortInput.text = Util.GString(\\\"serverPort\\\", \\\"8765\\\");\\n    fileServerPortInput.text = Util.GString(\\\"serverPort\\\", \\\"8000\\\");\\n    devSettingsButton.onClick.AddListener(OnDevSettingsButton);\\n    devSettingsCloseButton.onClick.AddListener(OnDevSettingsCloseButton);\\n    serverAddressInput.onValueChanged.AddListener(OnServerAddressChange);\\n    serverPortInput.onValueChanged.AddListener(OnServerPortChange);\\n    fileServerPortInput.onValueChanged.AddListener(OnFileServerPortChange);\\n\\n    if (serverEnabled) {\\n      InvokeRepeating(\\\"ConnectToServer\\\", 0f, 1f);\\n    }\\n  }\\n  void Update() {\\n    ProcessEdit();\\n    \\n    // editor input\\n    if (Input.GetKey(KeyCode.C)) {\\n      ClearLog();\\n    }\\n    if (Input.GetKey(KeyCode.P)) {\\n      Debug.Break();\\n    }\\n    if (Input.GetKey(KeyCode.R)) {\\n      Reload();\\n      return;\\n    }\\n    \\n    if (editCount == 0)\\n      Execute(\\\"update()\\\");\\n  }\\n  void LateUpdate() {\\n    if (editCount == 0)\\n      Execute(\\\"late_update()\\\");\\n  }\\n}\",\"selection\":{\"ranges\":[{\"anchor\":953,\"head\":953}],\"main\":0},\"fold\":[532,575,677,950,1820,2141,2183,2223,2299,7514,7545,7932,7967,8092,8129,8167,8191,8390,8412,8700,8726,8784,8804,8917,9010,9040,9077,9108,9153,9251,9293,9388,9434,9478,9531,10258,10289,10362,10393,10505,10530,10663,10718,10817,10853,10914,10947,11066,11154,12030,12049,12344,12367,12426]}";