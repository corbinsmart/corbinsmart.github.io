export default "{\"doc\":\"////////////\\n// CONSTANTS\\n////////////\\nconst tiltRange = 8\\nconst zoneCount = 8\\nconst tileCount = zoneCount-1\\nconst cam = f.camera\\nconst letters = 'abcdefghijklmnopqrstuvwxyz'.split('')\\nconst vowels = 'aeiou'.split('')\\nconst consonants = letters.filter(e => !vowels.includes(e))\\nconst uncommonTwoLetterWords = 'aa ab ad ae ag ah ai al ar as aw ay ba bi bo ch da de di ea ed ee ef eh el em en er es et ew ex fa fe fy gi gu ho io ja jo ka ki ko ky la li lo ma mi mm mo na ne nu ny ob od oe om oo op os ou ow oy pa pe pi po qi re sh si st ta te ti ug uh um un ur us ut wo xu ya ye yu za ze zo'.split(' ')\\nconst tileFlyInSpeed = 3\\n\\n////////\\n// STATE\\n////////\\nvar score = 0\\nvar remainingTileCount = 24\\nvar zones = []\\nvar tiles = []\\nvar submittedWords = []\\nvar selectedTile = null\\nvar selectedTileDelta = v3.zero\\nvar selectedTileZoneIndex = -1\\nvar selectedZoneIndex = -1\\nvar gameover = false\\nvar finalScoreT = 0\\nvar submittedWordXPositions = []\\n\\n////////////\\n// UTILITIES\\n////////////\\nfunction getLetter() {\\n    shuffle(vowels)\\n    shuffle(consonants)\\n    if (Random.value < 0.3)\\n        return vowels[0]\\n    else\\n        return consonants[0]\\n}\\nfunction getColor(name) {\\n    return f.COLOR.Child(name).SpriteRenderer().color\\n}\\nfunction getLetterValue(letter) {\\n    var groupValues = [1,2,3,4,5,8,10]\\n    var groups = [\\n        'aeioulnstr',\\n        'dg',\\n        'bcmp',\\n        'fhvwy',\\n        'k',\\n        'jx',\\n        'qz'\\n    ].map(e => e.split(''))\\n    for (var i = 0; i < groups.length; i++) {\\n        var group = groups[i]\\n        if (group.includes(letter))\\n            return groupValues[i]\\n    }\\n}\\nfunction getWordValue(word) {\\n    var rawValue = word.split('').map(e => getLetterValue(e)).reduce((e,acc) => e+acc)\\n    return Mathf.Max(1,Mathf.Floor(rawValue*(word.length)))\\n}\\nfunction mouseToWorld(mousePos) {\\n    var screenHeight = 8\\n    var screenWidth = 8*Screen.width/Screen.height\\n    return v(mousePos.x/Screen.width*screenWidth-screenWidth*0.5, mousePos.y/Screen.height*screenHeight, 0)\\n}\\nfunction getTile(gob) {\\n    var res = tiles.filter(e => e != null && e.gob != null && e.gob == gob)\\n    if (res.length > 0)\\n        return res[0]\\n    return null\\n}\\nfunction isValidWord(word) {\\n    if (word.length <= 1)\\n        return false\\n    if (word.length == 2 && uncommonTwoLetterWords.includes(word))\\n        return false\\n    return IsValidWord(word)\\n}\\nfunction getTilePos(t) {\\n    var i = tiles.indexOf(t)\\n    return v(0,0.5+i,0)\\n}\\nfunction getGameOverTileScale(t) {\\n    var height = Mathf.Min(0.8, (0.8*4)/submittedWords.length)\\n    return f.tile.transform.localScale.mul(height*1.3)\\n}\\nfunction getGameOverTilePos(t) {\\n    var height = Mathf.Min(0.8, (0.8*4)/submittedWords.length)\\n    var i = submittedWords.indexOf(t.word)\\n    var xPos = submittedWordXPositions[i]\\n    return f.gameover.Pos().add(v(xPos,0.25,0)).sub(v(0,i*height,0))\\n}\\nfunction positionTile(t) {\\n    var pos = getTilePos(t)\\n    t.gob.Pos(pos)\\n    t.gob.transform.localEulerAngles = v(0,0,-tiltRange*Random.value+tiltRange*0.5)\\n}\\nfunction makeTile(word) {\\n    var t = {\\n        word: word != null ? word : getLetter(),\\n        gob: make(f.tile),\\n        lerpT: 0,\\n        active: false\\n    }\\n    updateTile(t)\\n    return t\\n}\\nfunction updateTile(t) {\\n    if (t == null)\\n        return\\n    \\n    var word = t.gob.Child(\\\"word\\\").Text()\\n    var tile = t.gob.Child(\\\"tile\\\")\\n    var outline = t.gob.Child(\\\"outline\\\")\\n    var score = t.gob.Child(\\\"score\\\")\\n\\n    var isSelected = selectedTile == t\\n    var suffix = \\\"\\\"\\n\\n    // selected\\n    if (isSelected) {\\n        // ghost tile\\n        if (selectedZoneIndex != selectedTileZoneIndex && (selectedZoneIndex == zoneCount-1 || tiles[selectedZoneIndex] != null)) {\\n            var color = t.gob.Child(\\\"tile\\\").MeshRenderer().material.color\\n            color.a = 0.2\\n            t.gob.Child(\\\"tile\\\").MeshRenderer().material.color = color\\n\\n            color = word.color\\n            color.a = 0.5\\n            word.color = color\\n            \\n            color = score.Text().color\\n            color.a = 0.5\\n            score.Text().color = color\\n        }\\n        // normal tile\\n        else {\\n            var color = t.gob.Child(\\\"tile\\\").MeshRenderer().material.color\\n            color.a = 1\\n            t.gob.Child(\\\"tile\\\").MeshRenderer().material.color = color\\n\\n            color = word.color\\n            color.a = 1\\n            word.color = color\\n            \\n            color = score.Text().color\\n            color.a = 1\\n            score.Text().color = color\\n        }\\n    }\\n\\n    // not selected\\n    else {\\n        // append to word\\n        var zoneIndex = tiles.indexOf(t)\\n        if (selectedTile != null && selectedTile != t &&\\n            selectedZoneIndex == zoneIndex) {\\n            suffix = selectedTile.word\\n            outline.On()    \\n        }\\n        else {\\n            outline.Off()\\n        }\\n\\n        // validation\\n        var singleLetter = (word.text+suffix).length==1\\n        if (singleLetter)\\n            t.gob.Child(\\\"tile\\\").MeshRenderer().material.color = f.tile.Child('tile').MeshRenderer().material.color\\n        else {\\n            var valid = isValidWord(t.word+suffix)\\n            var color = valid ? getColor('valid') : getColor('invalid')\\n            t.gob.Child(\\\"tile\\\").MeshRenderer().material.color = color\\n        }\\n    }\\n\\n    // word\\n    word.text = t.word+suffix\\n\\n    // tile\\n    var margin = 0.5\\n    var outlineMargin = 0.2\\n    var width = word.preferredWidth+margin*2\\n    var scale = tile.transform.localScale\\n    scale.x = width\\n    tile.transform.localScale = scale\\n    outline.transform.localScale = scale.add(v(outlineMargin,outlineMargin,0))\\n\\n    // score\\n    score.Text().text = \\\"\\\"+getWordValue(word.text)\\n    var scoreMargin = 0.1\\n    var scorePos = score.transform.localPosition\\n    scorePos.x = width*0.5-scoreMargin\\n    score.transform.localPosition = scorePos\\n}\\nfunction killTile(t) {\\n    tiles[tiles.indexOf(t)] = null\\n    kill(t.gob)\\n}\\n\\n///////\\n// MAIN\\n///////\\nfunction init() {\\n    // setup zones\\n    zones = range(zoneCount).map(i => {\\n        var isHeader = i==zoneCount-1\\n        var temp = i%2==0 ? f.zone : f.zone2\\n        if (isHeader) temp = f.zoneheader\\n        var zone = make(temp)\\n        zone.Pos(v(0,0.5+i,1))\\n        return zone\\n    })\\n    \\n    // setup tiles\\n    tiles = range(tileCount).map(_ => makeTile())\\n    tiles.map(e => positionTile(e))\\n\\n    // ui\\n    f.gameover.Off()\\n}\\nfunction update() {\\n    var dt = Time.deltaTime\\n    var mousePos = Input.mousePosition\\n    var pos = mouseToWorld(mousePos)\\n    // f.box.Pos(pos)\\n\\n    if (!gameover) {\\n        // zones\\n        {\\n            selectedZoneIndex = -1\\n\\n            // header\\n            var header = zones[zoneCount-1]\\n            header.Child(\\\"score\\\").Text().text = \\\"\\\"+score\\n            header.Child(\\\"cards-icon\\\").Child(\\\"tilecount\\\").Text().text = \\\"\\\"+remainingTileCount\\n            header.MeshRenderer().material.color = getColor('header')\\n            header.Child(\\\"cards-icon\\\").SpriteRenderer().color = getColor('dark')\\n            header.Child(\\\"cards-icon\\\").Child(\\\"tilecount\\\").Text().color = getColor('dark')\\n            header.Child(\\\"score\\\").Text().color = getColor('dark')\\n\\n            // reset zones\\n            zones.map(e => {\\n                e.Child(\\\"selection\\\").Off()\\n            })\\n\\n            // select if hovering\\n            var ray = f.camera.Cam().ScreenPointToRay(Input.mousePosition)\\n            var hit = Raycast(ray, 100, 17)\\n            if (hit != null) {\\n                var zone = hit.obj.transform.gameObject\\n                selectedZoneIndex = zones.indexOf(zone)\\n\\n                // header\\n                if (selectedZoneIndex == zoneCount-1) {\\n                    if (selectedTile != null) {\\n                        var isValid = isValidWord(selectedTile.word)\\n                        // speculative points for valid word\\n                        if (isValid) {\\n                            var wordScore = getWordValue(selectedTile.word)\\n                            zone.Child(\\\"score\\\").Text().text = \\\"+\\\"+wordScore\\n                            zone.Child(\\\"score\\\").Text().color = getColor('white')\\n                            zone.Child(\\\"cards-icon\\\").SpriteRenderer().color = getColor('white')\\n                            zone.Child(\\\"cards-icon\\\").Child(\\\"tilecount\\\").Text().color = getColor('white')\\n                            zone.MeshRenderer().material.color = getColor('valid')\\n                        }\\n                        // trash word\\n                        else {\\n                            zone.Child(\\\"score\\\").Text().color = Color.white\\n                            zone.Child(\\\"cards-icon\\\").SpriteRenderer().color = Color.white\\n                            zone.Child(\\\"cards-icon\\\").Child(\\\"tilecount\\\").Text().color = Color.white\\n                            zone.MeshRenderer().material.color = getColor('invalid')\\n                        }\\n                    }\\n                }\\n                // rest of zones\\n                else {\\n                    zone.Child(\\\"selection\\\").On()\\n                }         \\n            }\\n        }\\n\\n        // grab tile\\n        if (Input.GetMouseButtonDown(0)) {\\n            var ray = f.camera.Cam().ScreenPointToRay(Input.mousePosition)\\n            var hit = Raycast(ray, 100, 17)\\n            if (hit != null) {\\n                selectedTile = tiles[selectedZoneIndex]\\n                if (selectedTile != null) {\\n                    selectedTileDelta = selectedTile.gob.Pos().sub(pos)\\n                    selectedTileDelta.z = 0\\n                    selectedTileZoneIndex = tiles.indexOf(selectedTile)\\n                }\\n            }\\n        }\\n\\n        // drag tile\\n        if (Input.GetMouseButton(0) && selectedTile != null) {\\n            var newPos = pos.add(selectedTileDelta)\\n            newPos.z = -1\\n            selectedTile.gob.Pos(newPos)\\n        }\\n\\n        // drop tile\\n        if (Input.GetMouseButtonUp(0) && selectedTile != null) {\\n            // back to starting zone\\n            if (selectedZoneIndex == selectedTileZoneIndex)\\n                positionTile(selectedTile)\\n            \\n            // to header zone\\n            else if (selectedZoneIndex == zoneCount-1) {\\n                var isValid = isValidWord(selectedTile.word)\\n                // score word\\n                if (isValid) {\\n                    score += getWordValue(selectedTile.word)\\n                    submittedWords.push(selectedTile.word)\\n                }\\n                else {\\n                }\\n                \\n                // trash it\\n                tiles[selectedTileZoneIndex] = null\\n                killTile(selectedTile)\\n            }\\n            \\n            // to dest zone\\n            else {\\n                var destTile = tiles[selectedZoneIndex]\\n                if (destTile == null) {\\n                    // copy to this zone\\n                    var copy = {\\n                        word: selectedTile.word,\\n                        gob: selectedTile.gob,\\n                        lerpT: 1,\\n                        active: true\\n                    }\\n                    tiles[selectedZoneIndex] = copy\\n                    tiles[selectedTileZoneIndex] = null\\n                    positionTile(copy)\\n                }\\n                else {\\n                    // append to this zone\\n                    destTile.word += selectedTile.word\\n                    killTile(selectedTile)\\n                }\\n            }\\n            \\n            // reset selection state\\n            selectedTile = null\\n            selectedTileDelta = v3.zero\\n            selectedTileZoneIndex = -1\\n        }\\n\\n        // spawn new tiles\\n        for (var i = 0; i < tiles.length; i++) {\\n            if (tiles[i] == null && remainingTileCount > 0) {\\n                var t = makeTile()\\n                tiles[i] = t\\n                positionTile(t)\\n                remainingTileCount--\\n            }\\n        }\\n    }\\n\\n    // update tiles\\n    tiles.map(tile => {\\n        updateTile(tile)\\n\\n        if (gameover) {\\n            // gameover fly in\\n            if (tile != null && !tile.active) {\\n                var startPos = zones[zoneCount-1].Pos()\\n                var toPos = getGameOverTilePos(tile)\\n                var toScale = getGameOverTileScale(tile)\\n                tile.lerpT += dt * tileFlyInSpeed\\n                if (tile.lerpT > 1) {\\n                    tile.lerpT = 1\\n                    tile.active = true\\n                }\\n                var t = Mathf.Sin(tile.lerpT*Mathf.PI*0.5)\\n                var pos = v3.Lerp(startPos, toPos, t)\\n                var scale = v3.Lerp(v3.zero, toScale, t)\\n                tile.gob.Pos(pos)\\n                tile.gob.transform.localScale = scale\\n            }\\n        }\\n        else {\\n            // fly in\\n            if (tile != null && !tile.active) {\\n                var startPos = mouseToWorld(v(0, Screen.height))\\n                var toPos = getTilePos(tile)\\n                tile.lerpT += dt * tileFlyInSpeed\\n                if (tile.lerpT > 1) {\\n                    tile.lerpT = 1\\n                    tile.active = true\\n                }\\n                var t = Mathf.Sin(tile.lerpT*Mathf.PI*0.5)\\n                var pos = v3.Lerp(startPos, toPos, t)\\n                var scale = v3.Lerp(v3.zero, f.tile.transform.localScale, t)\\n                tile.gob.Pos(pos)\\n                tile.gob.transform.localScale = scale\\n            }\\n        }\\n    })\\n\\n    // game over\\n    if (tiles.all(e => e == null) && !gameover) {\\n        zones.last().Off()\\n        f.gameover.Child(\\\"panel\\\").transform.localEulerAngles = v(0,0,-tiltRange*Random.value+tiltRange*0.5)\\n        f.gameover.On()\\n\\n        // set random x positions once\\n        submittedWordXPositions = range(submittedWords.length).map(_ => (-0.5+Random.value)*3)\\n        submittedWordXPositions.map(e => log(e))\\n\\n        // show submitted words\\n        tiles = submittedWords.map(word => {\\n            var t = makeTile(word)\\n            positionTile(t)\\n            return t\\n        })\\n\\n        log('game over')\\n        gameover = true\\n    }\\n\\n    if (gameover) {\\n        finalScoreT += dt\\n        if (finalScoreT >= 1) finalScoreT = 1\\n        var scoreVal = Mathf.Floor(Mathf.Lerp(0,score,finalScoreT*2))\\n        f.gameover.Child(\\\"panel\\\").Child(\\\"score\\\").Text().text = \\\"\\\"+scoreVal\\n        \\n        if (Input.GetMouseButtonDown(0)) {\\n            Reload(0)            \\n        }\\n    }\\n}\",\"selection\":{\"ranges\":[{\"anchor\":5892,\"head\":5892}],\"main\":0},\"fold\":[1000,1136,1163,1218,1253,1601,1632,1780,1815,2000,2025,2164,2194,2359,2385,2439,2475,2594,2628,2846,2874,3006,3033,3201,3227,5813,5837,5889,5933,6348,6369,14256]}";