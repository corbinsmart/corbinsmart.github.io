export default "{\"doc\":\"using System;\\nusing System.Linq;\\nusing System.Collections;\\nusing System.Collections.Generic;\\n\\nusing UnityEngine;\\nusing UnityEngine.UI;\\nusing UnityEngine.SceneManagement;\\n\\nusing TMPro;\\nusing UnityEditor;\\nusing Newtonsoft.Json;\\n\\nusing v2 = UnityEngine.Vector2;\\nusing v3 = UnityEngine.Vector3;\\nusing Gob = UnityEngine.GameObject;\\nusing Body2D = UnityEngine.Rigidbody2D;\\n\\nstruct SerializedV3 {\\n\\tpublic float x;\\n\\tpublic float y;\\n\\tpublic float z;\\n\\tpublic SerializedV3(v3 v) {\\n\\t\\tx = v.x;\\n\\t\\ty = v.y;\\n\\t\\tz = v.z;\\n\\t}\\n\\tpublic v3 ToV3() {\\n\\t\\treturn new v3(x,y,z);\\n\\t}\\n}\\n\\nstruct BoardData {\\n\\tpublic List<GroupData> groups;\\n}\\n\\nstruct GroupData {\\n\\tpublic SerializedV3 pos;\\n\\tpublic SerializedV3 rot;\\n\\tpublic List<BlockData> blocks;\\n}\\n\\nstruct BlockData {\\n\\tpublic SerializedV3 pos;\\n\\tpublic SerializedV3 rot;\\n\\tpublic int x;\\n\\tpublic int y;\\n\\tpublic int ci;\\n}\\n\\npublic class Block {\\n\\tpublic Gob gob;\\n\\tpublic Gob group;\\n\\tpublic int x;\\n\\tpublic int y;\\n\\tpublic int colorIndex;\\n\\tpublic Color color;\\n\\tpublic bool dying = false;\\n}\\n\\npublic class PopText {\\n\\tpublic Gob gob;\\n\\tpublic int val;\\n\\tpublic v3 lerpPos;\\n\\tpublic bool done;\\n}\\n\\npublic class Timer {\\n\\tpublic static List<Timer> all = new();\\n\\tpublic static void UpdateAll(float dt) {\\n\\t\\tforeach (Timer timer in all)\\n\\t\\t\\ttimer.Update(dt);\\n\\t}\\n\\n\\tfloat dur;\\n\\tpublic float t;\\n\\tpublic bool ready;\\n\\tpublic Timer(float d, bool _ready=false) {\\n\\t\\tdur = d;\\n\\t\\tt = dur;\\n\\t\\tready = _ready;\\n\\t\\tall.Add(this);\\n\\t}\\n\\tpublic void Reset() {\\n\\t\\tt = dur;\\n\\t\\tready = false;\\n\\t}\\n\\tvoid Update(float dt) {\\n\\t\\tif (!ready) {\\n\\t\\t\\tt -= dt;\\n\\t\\t\\tif (t < 0f)\\n\\t\\t\\t\\tready = true;\\n\\t\\t}\\n\\t}\\n\\n}\\n\\npublic class Main : MonoPlus {\\n\\t////////\\n\\t// LOGIC\\n\\t////////\\n\\tpublic int startScoreGoal;\\n\\tpublic int scoreGoalIncrement;\\n\\tpublic List<string> praises;\\n\\t\\n\\t//////////\\n\\t// OBJECTS\\n\\t//////////\\n\\t// values\\n\\tpublic Color goldColor;\\n\\tpublic Color paleColor;\\n\\n\\t// objects\\n\\tpublic Camera cam;\\n\\tpublic Canvas canvas;\\n\\tpublic Gob board;\\n\\tpublic TMP_Text scoreText;\\n\\tpublic Gob rewardedItem;\\n\\tpublic Gob draggableItem;\\n\\t\\n\\t// ui objects\\n\\tpublic RectTransform safeArea;\\n\\tpublic Gob header;\\n\\tpublic Slider scoreSlider;\\n\\tpublic Gob roundNumber;\\n\\tpublic Gob highScore;\\n\\tpublic Gob scoreSliderHandle;\\n\\tpublic Gob gameOverPanel;\\n\\tpublic Gob reviveGameView;\\t\\n\\tpublic Gob reviveHighScore;\\n\\tpublic Gob dock;\\n\\tpublic Gob noAdsSlot;\\n\\tpublic Gob settingsPanel;\\n\\tpublic SettingsToggle settingsHapticToggle;\\n\\tpublic Gob settingsRemoveAdsRow;\\n\\tpublic Gob settingsHighScore;\\n\\tpublic Gob settingsBlocksCleared;\\n\\tpublic List<Gob> dockSlots;\\n\\t\\n\\t// templates\\n\\tpublic Gob blockTemp;\\n\\tpublic Gob groupTemp;\\n\\tpublic Gob popTextTemp;\\t\\t\\n\\tpublic Gob explosionTemp;\\n\\tpublic Gob wallTemp;\\n\\n\\t// lists\\n\\tpublic List<Material> blockMats;\\n\\tpublic List<Sprite> blockSprites;\\n\\n\\t////////////\\n\\t// CONSTANTS\\n\\t////////////\\n\\tconst float refHeight = 2208;\\n\\tconst float blockWidth = (256f-4f)/256f;\\n\\treadonly string[] colorNames = {\\\"red\\\", \\\"blue\\\", \\\"yellow\\\", \\\"magenta\\\", \\\"cyan\\\", \\\"tan\\\"};\\n\\n\\t////////\\n\\t// STATE\\n\\t////////\\n\\tList<Gob> groups = new();\\n\\tList<Block> blocks = new();\\n\\tList<PopText> popTexts = new();\\n\\tHashSet<Gob> dyingBlocks = new();\\n\\tHashSet<string> states = new();\\n\\tint roundIndex;\\n\\tint score;\\n\\tBounds boardBounds;\\n\\tint scoreGoal;\\n\\tint lastDyingBlockCount = 0;\\n\\tGob lastGroup;\\n\\tv3 lastGroupPos;\\n\\tv3 lastCollisionPos;\\n\\tfloat groupExtentX;\\n\\tfloat dropY;\\n\\tint scoreToAdd;\\n\\tfloat timeAboveBoard;\\n\\tint dyingGroupCount = 0;\\n\\tfloat dyingGroupTimer = 0f;\\n\\tfloat dyingGroupDur = 2f;\\n\\tfloat timeScale = 1f;\\n\\tfloat lastGroupMaxY = 0f;\\n\\tbool paused;\\n\\tbool betweenRounds;\\n\\tbool alive;\\n\\tbool hitUI;\\n\\tbool draggingItem;\\n\\tstring itemType;\\n\\tint itemColor;\\n\\tList<string> dockItems = new() {\\\"_\\\",\\\"_\\\",\\\"_\\\"};\\n\\tGob activeDockSlot;\\n\\tv3 scoreSliderHandleScale = v3.one;\\n\\tpublic Timer hitHapticTimer;\\n\\tTimer clearHapticTimer;\\n\\tbool shouldSaveBoard;\\n\\tint lastHighScore;\\n\\tv3 initialCamPos;\\n\\tDictionary<Gob, bool> isGroupSimulated;\\n\\n\\t/////////\\n\\t// PUBLIC\\n\\t/////////\\n\\tpublic void OnRestorePurchases() {\\n\\t\\tOnPurchaseRemoveAds();\\n\\t}\\n\\tpublic void OnPurchaseRemoveAdsTestMode() {\\n\\t\\tif (IAP.iapTestMode)\\n\\t\\t\\tOnPurchaseRemoveAds();\\n\\t}\\n\\tpublic void OnPurchaseRemoveAds() {\\n\\t\\tUtil.Bool(\\\"noads\\\", true);\\n\\t\\tAds.Stop();\\n\\t\\tnoAdsSlot.Off();\\n\\t\\tsettingsRemoveAdsRow.Off();\\n\\t}\\n\\tpublic void OnPurchaseRemoveAdsFailed() {\\n\\t\\tlog(\\\"purchase failed!!!\\\");\\n\\t}\\n\\tpublic void OnFirstCollision() {\\n\\t\\tSpawnGroup();\\n\\t\\tshouldSaveBoard = true;\\n\\t}\\n\\tpublic void OnDockSlot(Gob dockSlot) {\\n\\t\\tif (!alive)\\n\\t\\t\\treturn;\\n\\t\\tSelectItem(dockSlot);\\n\\t}\\n\\tpublic void OnUI(Gob uiElement) {\\n\\t\\thitUI = true;\\n\\t}\\n\\tpublic void BucketFill(Gob gob, int colorIndex, bool preview=false) {\\n\\t\\tforeach (Block b in blocks) {\\n\\t\\t\\tif (b.gob == gob) {\\n\\t\\t\\t\\tint gobColorIndex = b.colorIndex;\\n\\t\\t\\t\\tforeach (Block b1 in blocks) {\\n\\t\\t\\t\\t\\tif (b1.colorIndex == gobColorIndex) {\\n\\t\\t\\t\\t\\t\\tb1.color = blockMats[colorIndex].color;\\n\\t\\t\\t\\t\\t\\tb1.gob.SpriteRenderer().material.color = b1.color;\\n\\t\\t\\t\\t\\t\\tif (!preview) {\\n\\t\\t\\t\\t\\t\\t\\tb1.gob.tag = colorNames[colorIndex];\\n\\t\\t\\t\\t\\t\\t\\tb1.colorIndex = colorIndex;\\n\\t\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tbreak;\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tpublic void FillAdjacent(Gob gob, v3 contactPoint, int colorIndex) {\\n\\t\\tif (!alive)\\n\\t\\t\\treturn;\\n\\t\\tif (gob.Parent() == null)\\n\\t\\t\\treturn;\\n\\t\\t\\n\\t\\tGob group = gob.Parent();\\n\\t\\tList<Block> connected = GetConnected(gob, true);\\n\\t\\tforeach (Block b in connected) {\\n\\t\\t\\tb.colorIndex = colorIndex;\\n\\t\\t\\tb.color = blockMats[colorIndex].color;\\n\\t\\t\\tb.gob.tag = colorNames[colorIndex];\\n\\t\\t\\tb.gob.SpriteRenderer().material = blockMats[colorIndex];\\n\\t\\t}\\n\\n\\t\\t// sprite indices\\n\\t\\tforeach (Block b in blocks) {\\n\\t\\t\\tint ind = 0;\\n\\t\\t\\tif (b.gob.Parent() != null)\\n\\t\\t\\t\\tind = GetTileIndex(b.gob.Parent(), b.x,b.y);\\n\\t\\t\\tb.gob.SpriteRenderer().sprite = blockSprites[ind];\\n\\t\\t}\\n\\t\\treturn;\\n\\t}\\n\\tpublic void KillAdjacent(Gob gob, v3 contactPoint) {\\n\\t\\tif (!alive)\\n\\t\\t\\treturn;\\n\\t\\tif (gob.Parent() == null)\\n\\t\\t\\treturn;\\n\\t\\t\\n\\t\\tlastCollisionPos = contactPoint;\\n\\t\\t\\n\\t\\tGob group = gob.Parent();\\n\\t\\tList<Block> connected = GetConnected(gob, true);\\n\\t\\tforeach (Block b in connected) {\\n\\t\\t\\tblocks.Remove(b);\\n\\t\\t\\tb.gob.Orphan();\\n\\t\\t}\\n\\n\\t\\t// check for islands\\n\\t\\tHashSet<Gob> gs = new() {group};\\n\\t\\tList<Block> blocksInGroup = GetBlocksInGroup(group);\\n\\t\\twhile (blocksInGroup.Count > 0) {\\n\\t\\t\\tBlock b = blocksInGroup[0];\\n\\t\\t\\tHashSet<Block> conn = new HashSet<Block>(GetConnected(b.gob));\\n\\t\\t\\tif (conn.Count == blocksInGroup.Count)\\n\\t\\t\\t\\tbreak;\\n\\t\\t\\tforeach (Block b1 in conn) {\\n\\t\\t\\t\\tblocksInGroup.Remove(b1);\\n\\t\\t\\t\\tblocks.Remove(b1);\\n\\t\\t\\t}\\n\\t\\t\\tgs.Add(MakeGroup(b.gob.Pos(), new List<Block>(conn), 0, 0, true));\\n\\t\\t}\\n\\t\\tif (blocksInGroup.Count == 0) {\\n\\t\\t\\tkill(group);\\n\\t\\t\\tgs.Remove(group);\\n\\t\\t\\tgroups.Remove(group);\\n\\t\\t}\\n\\n\\t\\t// sprite indices\\n\\t\\tforeach (Block b in blocks) {\\n\\t\\t\\tint ind = 0;\\n\\t\\t\\tif (b.gob.Parent() != null)\\n\\t\\t\\t\\tind = GetTileIndex(b.gob.Parent(), b.x,b.y);\\n\\t\\t\\tb.gob.SpriteRenderer().sprite = blockSprites[ind];\\n\\t\\t}\\n\\t\\t\\n\\t\\t// pop text\\n\\t\\tPopText pop = new PopText() {gob=make(popTextTemp), val=0, lerpPos=contactPoint, done=false};\\n\\t\\tpop.gob.Pos(contactPoint);\\n\\t\\tpopTexts.Add(pop);\\n\\t\\t\\n\\t\\t// sequentially destroy\\n\\t\\tIEnumerator DestroyBlock(Gob box) {\\n\\t\\t\\tv3 startScale = box.transform.localScale;\\n\\t\\t\\tv3 endScale = box.transform.localScale*0f;\\n\\t\\t\\tif (clearHapticTimer.ready) {\\n\\t\\t\\t\\tUtil.Haptic(HapticStrength.Heavy);\\n\\t\\t\\t\\tclearHapticTimer.Reset();\\n\\t\\t\\t}\\n\\t\\t\\tDo(0f, 1f, 0.2f, Motion.COS, t => {\\n\\t\\t\\t\\tif (box != null) {\\n\\t\\t\\t\\t\\tbox.transform.localScale = Lerp(startScale,endScale,t);\\n\\t\\t\\t\\t\\tbox.SpriteRenderer().material.color = box.SpriteRenderer().material.color.alpha(lerp(0.7f,0f,t));\\n\\t\\t\\t\\t}\\n\\t\\t\\t});\\n\\t\\t\\tyield return new WaitForSeconds(0.11f);\\n\\t\\t\\tdyingBlocks.Remove(box);\\n\\t\\t\\tkill(box);\\n\\t\\t}\\n\\t\\tIEnumerator MoveBlockToGoal(Gob box) {\\n\\t\\t\\tv3 startScale = box.transform.localScale;\\n\\t\\t\\tv3 endScale = box.transform.localScale*0f;\\n\\t\\t\\tDo(0f, 1f, 0.2f, Motion.COS, t => {\\n\\t\\t\\t\\tif (box != null) {\\n\\t\\t\\t\\t\\tbox.transform.localScale = Lerp(startScale,endScale,t);\\n\\t\\t\\t\\t\\tbox.SpriteRenderer().material.color = box.SpriteRenderer().material.color.alpha(lerp(0.7f,0f,t));\\n\\t\\t\\t\\t}\\n\\t\\t\\t});\\n\\t\\t\\tyield return new WaitForSeconds(0.11f);\\n\\t\\t\\tdyingBlocks.Remove(box);\\n\\t\\t\\tkill(box);\\n\\t\\t}\\n\\t\\tIEnumerator _() {\\n\\t\\t\\tList<Color> connectedColors = new();\\n\\t\\t\\tforeach (Block b in connected) {\\n\\t\\t\\t\\tb.gob.gc<BoxCollider2D>().enabled = false;\\n\\t\\t\\t\\tconnectedColors.Add(b.gob.SpriteRenderer().material.color);\\n\\t\\t\\t\\tdyingBlocks.Add(b.gob);\\n\\t\\t\\t}\\n\\n\\t\\t\\t// pop on\\n\\t\\t\\tpop.gob.On();\\n\\t\\t\\tfloat shiftDelay = 0.01f;\\n\\t\\t\\tIEnumerator MovePop() {\\n\\t\\t\\t\\tfor (int i = 0; i < connected.Count; i++) {\\n\\t\\t\\t\\t\\tpop.lerpPos = connected[i].gob.Pos();\\n\\t\\t\\t\\t\\tpop.val++;\\n\\t\\t\\t\\t\\tpop.gob.Text().text = \\\"\\\"+pop.val;\\n\\t\\t\\t\\t\\tyield return new WaitForSeconds(shiftDelay);\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t\\tStartCoroutine(MovePop());\\n\\t\\t\\t\\n\\t\\t\\t// color white\\n\\t\\t\\tfloat delay = 0.01f;\\n\\t\\t\\tfor (int i = 0; i < connected.Count; i++) {\\n\\t\\t\\t\\tBlock b = connected[i];\\n\\t\\t\\t\\tColor c = connectedColors[i];\\n\\t\\t\\t\\tGob box = b.gob;\\n\\t\\t\\t\\t\\n\\t\\t\\t\\tDo(0f, 1f, 0.05f, Motion.COS, t => {\\n\\t\\t\\t\\t\\tif (box != null)\\n\\t\\t\\t\\t\\t\\tbox.SpriteRenderer().material.color = Color.Lerp(c, Color.white, t);\\n\\t\\t\\t\\t});\\n\\t\\t\\t\\tyield return new WaitForSeconds(delay);\\n\\t\\t\\t}\\n\\n\\t\\t\\t// pop done\\n\\t\\t\\tpop.done = true;\\n\\t\\t\\t\\n\\t\\t\\t// destroy\\n\\t\\t\\tint bi = 0;\\n\\t\\t\\tfloat totalDelay = 0.05f - (dyingGroupCount/2)*0.025f;\\n\\t\\t\\ttimeScale = 1f + (dyingGroupCount/2f)*0.2f;\\n\\t\\t\\tforeach (Block b in connected) {\\n\\t\\t\\t\\tbi++;\\n\\t\\t\\t\\tdelay = Mathf.Sin((float)bi/connected.Count) * totalDelay;\\n\\t\\t\\t\\tGob box = b.gob;\\n\\t\\t\\t\\tStartCoroutine(DestroyBlock(box));\\n\\t\\t\\t\\tyield return new WaitForSeconds(delay);\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tStartCoroutine(_());\\n\\n\\t\\tdyingGroupCount++;\\n\\t\\tdyingGroupTimer = 0f;\\n\\t}\\n\\tpublic void OnPlayAgain() {\\n\\t\\tstring currentSceneName = SceneManager.GetActiveScene().name;\\n\\t\\tSceneManager.LoadScene(currentSceneName);\\n\\t}\\n\\tpublic void OnSettings() {\\n\\t\\tsettingsHighScore.Text().text = \\\"\\\"+Util.GInt(\\\"highScore\\\", 1);\\n\\t\\tsettingsBlocksCleared.Text().text = \\\"\\\"+Util.GInt(\\\"blocksCleared\\\", 0);\\n\\t\\tsettingsPanel.On();\\n\\n\\t\\theader.Off();\\n\\t\\tdock.Off();\\n\\t\\tscoreSlider.gameObject.Off();\\n\\n\\t\\tisGroupSimulated = new();\\n\\t\\tforeach (Block block in blocks) {\\n\\t\\t\\tGob group = block.gob.Parent();\\n\\t\\t\\tif (group != null) {\\n\\t\\t\\t\\tif (!isGroupSimulated.ContainsKey(group))\\n\\t\\t\\t\\t\\tisGroupSimulated[group] = group.Body2D().simulated;\\n\\t\\t\\t\\tgroup.Body2D().simulated = false;\\n\\t\\t\\t}\\n\\t\\t\\tblock.gob.Off();\\n\\t\\t}\\n\\t\\t\\n\\t\\tpaused = true;\\n\\t}\\n\\tpublic void OnSettingsResume() {\\n\\t\\theader.On();\\n\\t\\tdock.On();\\n\\t\\tscoreSlider.gameObject.On();\\n\\t\\t\\n\\t\\tforeach (Block block in blocks) {\\n\\t\\t\\tGob group = block.gob.Parent();\\n\\t\\t\\tif (group != null) {\\n\\t\\t\\t\\tif (isGroupSimulated.ContainsKey(group))\\n\\t\\t\\t\\t\\tgroup.Body2D().simulated = isGroupSimulated[group];\\n\\t\\t\\t}\\n\\t\\t\\tblock.gob.On();\\n\\t\\t}\\n\\n\\t\\tsettingsPanel.Off();\\n\\t\\tpaused = false;\\n\\t}\\n\\n\\t//////////\\n\\t// LIBRARY\\n\\t//////////\\n\\tbool Get(string state) {\\n\\t\\treturn states.Contains(state);\\n\\t}\\n\\tvoid Set(string state, bool val) {\\n\\t\\tif (val)\\n\\t\\t\\tstates.Add(state);\\n\\t\\telse\\n\\t\\t\\tstates.Remove(state);\\n\\t}\\n\\tvoid On(string state) {\\n\\t\\tSet(state, true);\\n\\t}\\n\\tvoid Off(string state) {\\n\\t\\tSet(state, false);\\n\\t}\\n\\n\\tv3 ui2WorldPos(Gob uiElement) {\\n\\t\\tv3[] corners = new v3[4];\\n\\t\\tuiElement.RectTransform().GetWorldCorners(corners);\\n\\t\\treturn (corners[0]+corners[2])/2f;\\n\\t}\\n\\tBlock MakeBlock(v3 pos, int i, int j, int colorIndex, bool active=false) {\\n\\t\\tGob b = make(blockTemp);\\n\\t\\tb.On();\\n\\t\\tb.tag = colorNames[colorIndex];\\n\\t\\tb.SpriteRenderer().material = blockMats[colorIndex];\\n\\t\\tif (active)\\n\\t\\t\\tb.Child(\\\"shadow\\\").Off();\\n\\t\\telse\\n\\t\\t\\tb.Child(\\\"shadow\\\").Child(\\\"flame\\\").SpriteRenderer().color = blockMats[colorIndex].color.alpha(0.15f);\\n\\t\\tb.Pos(pos);\\n\\t\\treturn new Block() {gob=b, group=null, x=i, y=j, colorIndex=colorIndex, color=blockMats[colorIndex].color};\\n\\t}\\n\\tGob MakeGroup(v3 pos, v3 eulerAngles, List<Block> bs) {\\n\\t\\tGob group = make(groupTemp);\\n\\t\\tgroup.On();\\n\\t\\tgroup.gc<BlockGroup>().main = this;\\n\\t\\tgroup.Body2D().mass = bs.Count;\\n\\t\\tgroup.Pos(pos);\\n\\t\\tforeach (Block b in bs) {\\n\\t\\t\\tb.gob.transform.SetParent(group.transform, true);\\n\\t\\t\\tblocks.Add(new Block() {gob=b.gob, group=group, x=b.x, y=b.y, colorIndex=b.colorIndex, color=b.color});\\n\\t\\t}\\n\\t\\tgroup.transform.eulerAngles = eulerAngles;\\n\\t\\treturn group;\\n\\t}\\n\\tGob MakeGroup(v3 pos, List<Block> bs, int w, int h, bool active=false) {\\n\\t\\tv3 eulerAngles = v3.zero;\\n\\t\\tbool rotated = randf < 0.75f;\\n\\t\\tif (!active) {\\n\\t\\t\\tfloat angle = randf < 0.5f ? 45f : -45f;\\n\\t\\t\\teulerAngles = new v3(0f,0f, rotated ? angle : 0f);\\n\\t\\t}\\n\\t\\tGob group = MakeGroup(pos, eulerAngles, bs);\\n\\t\\t\\n\\t\\t// sprite indices\\n\\t\\tforeach (Block b in bs) {\\n\\t\\t\\tint ind = GetTileIndex(group, b.x,b.y);\\n\\t\\t\\tb.gob.SpriteRenderer().sprite = blockSprites[ind];\\n\\t\\t}\\n\\n\\t\\tif (active) {\\n\\t\\t\\tgroup.Body2D().constraints = RigidbodyConstraints2D.FreezeAll;\\n\\t\\t\\tgroup.Body2D().simulated = true;\\n\\t\\t\\tgroup.gc<BlockGroup>().hasCollided = true;\\n\\t\\t}\\n\\t\\telse {\\n\\t\\t\\tgroup.Body2D().simulated = false;\\n\\n\\t\\t\\t// block shadows\\n\\t\\t\\tforeach (Block b in bs) {\\n\\t\\t\\t\\tb.gob.Child(\\\"shadow\\\").transform.eulerAngles = v3.zero;\\n\\t\\t\\t\\tif (rotated) {\\n\\t\\t\\t\\t\\tv3 scale = b.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").transform.localScale;\\n\\t\\t\\t\\t\\tscale.x = Mathf.Sqrt(2f)*blockWidth*0.5f;\\n\\t\\t\\t\\t\\tb.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").transform.localScale = scale;\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\telse {\\n\\t\\t\\t\\t\\tv3 scale = b.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").transform.localScale;\\n\\t\\t\\t\\t\\tscale.x = 1f*blockWidth*0.5f;\\n\\t\\t\\t\\t\\tb.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").transform.localScale = scale;\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tgroups.Add(group);\\n\\t\\treturn group;\\n\\t}\\n\\tGob MakeGroup(v3 pos, int w, int h, bool active=false) {\\n\\t\\tList<int> indices = range(6);\\n\\t\\tindices.Shuffle();\\n\\n\\t\\tList<string> patterns = new() {\\\"cake244\\\",\\\"cake3\\\",\\\"cake33\\\",\\\"cake4\\\",\\\"cake44\\\", \\\"checker3\\\",\\\"checker4\\\",\\\"checker23\\\",\\\"checker24\\\", \\\"eye3\\\", \\\"eye5\\\", \\\"corner33\\\", \\\"corner4\\\", \\\"corner44\\\", \\\"spiral6\\\", \\\"x\\\", \\\"x2\\\", \\\"stair3\\\", \\\"stair4\\\", \\\"t1\\\", \\\"loose5\\\"};\\n\\t\\tstring pattern = patterns.Random();\\n\\t\\tTexture2D tex = Resources.Load<Texture2D>(\\\"block-patterns/\\\"+pattern);\\n\\t\\tbool rotated = randf < 0.5f;\\n\\t\\tbool flipped = randf < 0.5f;\\n\\t\\tbool randgen = false;//randf < 0.5f;\\n\\t\\tif (!randgen) {\\n\\t\\t\\tw = tex.width;\\n\\t\\t\\th = tex.height;\\n\\t\\t}\\n\\n\\t\\tList<Block> bs = new();\\n\\t\\tfor (int i = 0; i < w; i++) {\\n\\t\\t\\tfor (int j = 0; j < h; j++) {\\n\\t\\t\\t\\tint ci = 0;\\n\\t\\t\\t\\tif (randgen) {\\n\\t\\t\\t\\t\\tci = Rand(2);\\n\\t\\t\\t\\t\\tci = indices[ci];\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\telse {\\n\\t\\t\\t\\t\\tint ii = flipped ? w-1-i : i;\\n\\t\\t\\t\\t\\tint jj = flipped ? h-1-j : j;\\n\\t\\t\\t\\t\\tColor pixel = rotated ? tex.GetPixel(ii,jj) : tex.GetPixel(jj,ii);\\n\\t\\t\\t\\t\\tbool clear = pixel == Color.clear;\\n\\t\\t\\t\\t\\tif (clear)\\n\\t\\t\\t\\t\\t\\tcontinue;\\n\\t\\t\\t\\t\\tList<Color> colorOrder = new() {Color.black, Color.white, Color.red, Color.blue};\\n\\t\\t\\t\\t\\tci = colorOrder.IndexOf(pixel);\\n\\t\\t\\t\\t\\tci = indices[ci];\\n\\t\\t\\t\\t}\\n\\n\\t\\t\\t\\tv3 blockPos = pos - new v3(blockWidth,blockWidth)*0.5f + new v3(-w*blockWidth*0.5f+(i+1)*blockWidth,-h*blockWidth*0.5f+(j+1)*blockWidth);\\n\\t\\t\\t\\tBlock block = MakeBlock(blockPos, i, j, ci);\\n\\t\\t\\t\\tbs.Add(block);\\n\\t\\t\\t}\\n\\t\\t}\\n\\n\\t\\treturn MakeGroup(pos, bs, w, h, active);\\n\\t}\\n\\tvoid SpawnGroup() {\\n\\t\\tif (lastGroup != null)\\n\\t\\t\\treturn;\\n\\t\\t\\n\\t\\tlastGroup = MakeGroup(v3.zero, Mathf.FloorToInt(rand(2,5)), Mathf.FloorToInt(rand(2,5)));\\n\\t\\tPhysics2D.SyncTransforms();\\n\\t\\tBounds groupBounds = GetGroupBounds(lastGroup);\\n\\t\\tgroupExtentX = groupBounds.extents.x;\\n\\t\\tfloat maxGroupY = GetMaxGroupY();\\n\\t\\tfloat buf = 0.5f;\\n\\t\\tfloat topY = max(board.Pos().y+boardBounds.extents.y, maxGroupY);\\n\\t\\tdropY = topY + groupBounds.extents.y + buf;\\n\\t\\tlastGroupPos = v3.up * dropY;\\n\\t\\tlastGroup.Pos(lastGroupPos);\\n\\t\\tPhysics2D.SyncTransforms();\\n\\n\\t\\tDo(v3.zero, v3.one, 0.25f, Motion.COS, scale => {\\n\\t\\t\\tif (lastGroup != null)\\n\\t\\t\\t\\tlastGroup.transform.localScale = scale;\\n\\t\\t});\\n\\t}\\n\\tBounds GetGroupBounds(Gob group) {\\n\\t\\tBody2D body = group.Body2D();\\n\\t\\tint colliderCount = body.attachedColliderCount;\\n\\t\\tList<Collider2D> colliders = new();\\n\\t\\tbody.GetAttachedColliders(colliders);\\n\\t\\tBounds compoundBounds = new Bounds(group.Pos(), v3.zero);\\n\\t\\tfor (int i = 0; i < colliderCount; i++) {\\n\\t\\t\\tcompoundBounds.Encapsulate(colliders[i].bounds);\\n\\t\\t}\\n\\t\\treturn compoundBounds;\\n\\t}\\n\\tList<Block> GetAdjacent(Block block, bool matchColor=false) {\\n\\t\\treturn blocks.Where(e => {\\n\\t\\t\\tint dx = Abs(e.x-block.x);\\n\\t\\t\\tint dy = Abs(e.y-block.y);\\n\\t\\t\\treturn e.group == block.group &&\\n\\t\\t\\t\\t   ((dx==1 && dy==0) || (dx==0 && dy==1)) &&\\n\\t\\t\\t\\t   (!matchColor || (e.gob.tag == block.gob.tag));\\n\\t\\t}).ToList();\\n\\t}\\n\\tList<Block> GetBlocksInGroup(Gob group) {\\n\\t\\treturn blocks.Where(e => e.group == group).ToList();\\n\\t}\\n\\tBlock? GetBlockAt(Gob group, int x, int y) {\\n\\t\\tList<Block> matches = GetBlocksInGroup(group)\\n\\t\\t\\t.Where(e => e.x == x && e.y == y).ToList();\\n\\t\\tif (matches.Count == 1)\\n\\t\\t\\treturn matches[0];\\n\\t\\treturn null;\\n\\t}\\n\\tBlock? GetBlock(Gob gob) {\\n\\t\\tList<Block> bs = blocks.Where(e => e.gob == gob).ToList();\\n\\t\\treturn bs.Count > 0 ? bs[0] : null;\\n\\t}\\n\\tint GetTileIndex(Gob group, int x, int y) {\\n\\t\\tbool above = GetBlockAt(group, x,y+1) != null;\\n\\t\\tbool right = GetBlockAt(group, x+1,y) != null;\\n\\t\\tbool below = GetBlockAt(group, x,y-1) != null;\\n\\t\\tbool left = GetBlockAt(group, x-1,y) != null;\\n\\n\\t\\tint sum = 0;\\n\\t\\tif (above) sum += 1;\\n\\t\\tif (left) sum += 2;\\n\\t\\tif (right) sum += 4;\\n\\t\\tif (below) sum += 8;\\n\\n\\t\\treturn sum;\\n\\t}\\n\\tint GetTileIndex(List<List<int>> map, int x, int y) {\\n\\t\\tint GetTileAt(int xx, int yy) {\\n\\t\\t\\tint w = map[0].Count;\\n\\t\\t\\tint h = map.Count;\\n\\t\\t\\tif (xx < 0 || xx >= w || yy < 0 || yy >= h)\\n\\t\\t\\t\\treturn -1;\\n\\t\\t\\treturn map[yy][xx];\\n\\t\\t}\\n\\n\\t\\tbool above = GetTileAt(x,y+1) != -1;\\n\\t\\tbool right = GetTileAt(x+1,y) != -1;\\n\\t\\tbool below = GetTileAt(x,y-1) != -1;\\n\\t\\tbool left = GetTileAt(x-1,y) != -1;\\n\\n\\t\\tint sum = 0;\\n\\t\\tif (above) sum += 1;\\n\\t\\tif (left) sum += 2;\\n\\t\\tif (right) sum += 4;\\n\\t\\tif (below) sum += 8;\\n\\n\\t\\treturn sum;\\n\\t}\\n\\tList<Block> GetConnected(Gob gob, bool matchColor=false) {\\n\\t\\tBlock? _origin = GetBlock(gob);\\n\\t\\tif (_origin == null)\\n\\t\\t\\treturn new();\\n\\n\\t\\tBlock origin = (Block)_origin;\\n\\t\\tQueue<Block> frontier = new();\\n\\t\\tfrontier.Enqueue(origin);\\n\\t\\tHashSet<Block> reached = new() {origin};\\n\\n\\t\\twhile (frontier.Count > 0) {\\n\\t\\t\\tBlock current = frontier.Dequeue();\\n\\t\\t\\tforeach (Block next in GetAdjacent(current, matchColor)) {\\n\\t\\t\\t\\tif (!reached.Contains(next)) {\\n\\t\\t\\t\\t\\tfrontier.Enqueue(next);\\n\\t\\t\\t\\t\\treached.Add(next);\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\n\\t\\treturn reached.ToList();\\n\\t}\\n\\tbool AnyGroupsAboveBoard(ref List<Gob> gs) {\\n\\t\\tforeach (Gob g in groups) {\\n\\t\\t\\tif (g == lastGroup || !g.gc<BlockGroup>().hasCollided/*|| !stationary*/)\\n\\t\\t\\t\\tcontinue;\\n\\t\\t\\tBounds b = GetGroupBounds(g);\\n\\t\\t\\tif (b.max.y > boardBounds.max.y)\\n\\t\\t\\t\\tgs.Add(g);\\n\\t\\t}\\n\\t\\treturn gs.Count > 0;\\n\\t}\\n\\tList<Block> GetBlocksAboveBoard(List<Gob> groupsAbove) {\\n\\t\\tList<Block> bs = new();\\n\\t\\tforeach (Gob g in groupsAbove) {\\n\\t\\t\\tforeach (Block b in GetBlocksInGroup(g)) {\\n\\t\\t\\t\\tif (b.gob.BoxCollider2D().bounds.max.y > boardBounds.max.y)\\n\\t\\t\\t\\t\\tbs.Add(b);\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn bs;\\n\\t}\\n\\tfloat GetMaxGroupY(bool includeLast=false) {\\n\\t\\tfloat maxY = boardBounds.min.y;\\n\\t\\tList<Block> bs = new();\\n\\t\\tforeach (Gob g in groups) {\\n\\t\\t\\tif (g == lastGroup && !includeLast)\\n\\t\\t\\t\\tcontinue;\\n\\t\\t\\tBounds b = GetGroupBounds(g);\\n\\t\\t\\tif (b.max.y > maxY)\\n\\t\\t\\t\\tmaxY = b.max.y;\\n\\t\\t}\\n\\t\\treturn maxY;\\n\\t}\\n\\tvoid ShowGameOverPanel(bool newHighScore) {\\n\\t\\tif (newHighScore) {\\n\\t\\t\\tgameOverPanel.Child(\\\"title\\\").Text().text = \\\"New Best!\\\";\\n\\t\\t\\treviveHighScore.Child(\\\"crown\\\").Child(\\\"high score\\\").Text().text = \\\"\\\"+Util.GInt(\\\"highScore\\\",1);\\n\\t\\t\\treviveHighScore.On();\\n\\t\\t\\tDo(v3.one*0.5f, v3.one*1.435882f, 0.5f, Motion.SMOOTH, scale => reviveHighScore.transform.localScale = scale);\\n\\t\\t}\\n\\t\\telse {\\n\\t\\t\\tfloat completion = (float)score/scoreGoal;\\n\\t\\t\\tgameOverPanel.Child(\\\"title\\\").Text().text = completion < 0.7f ? \\\"Keep Going!\\\" : \\\"So Close!\\\";\\n\\t\\t}\\n\\t\\tgameOverPanel.On();\\n\\t}\\n\\tSprite LoadItemSprite(string itemName) {\\n\\t\\tTexture2D itemTex = Resources.Load<Texture2D>(\\\"items/\\\"+itemName);\\n\\t\\treturn Sprite.Create(itemTex, new Rect(0f, 0f, itemTex.width, itemTex.height), new v2(0.5f,0.5f));\\n\\t}\\n\\tvoid LoadGame() {\\n\\t\\tbool gameOver = Util.GBool(\\\"gameOver\\\", true);\\n\\t\\tif (gameOver)\\n\\t\\t\\treturn;\\n\\n\\t\\t// dock\\n\\t\\tstring dockString = Util.GString(\\\"dock\\\", \\\"_,_,_\\\");\\n\\t\\tlog(dockString);\\n\\t\\tdockItems = dockString.Split(',').ToList();\\n\\t\\tfor (int i = 0; i < dockItems.Count; i++) {\\n\\t\\t\\tlog(dockItems[i]);\\n\\t\\t\\tif (dockItems[i] != \\\"_\\\") {\\n\\t\\t\\t\\tdockSlots[i].Child(\\\"item\\\").On();\\n\\t\\t\\t\\tSprite s = LoadItemSprite(dockItems[i]);\\n\\t\\t\\t\\tlog(s);\\n\\t\\t\\t\\tdockSlots[i].Child(\\\"item\\\").Image().sprite = LoadItemSprite(dockItems[i]);\\n\\t\\t\\t}\\n\\t\\t}\\n\\n\\t\\troundIndex = Util.GInt(\\\"roundIndex\\\", 0);\\n\\t\\tscore = Util.GInt(\\\"score\\\", 0);\\n\\n\\t\\t// groups\\n\\t\\tstring boardString = Util.GString(\\\"board\\\", \\\"\\\");\\n\\t\\tif (boardString != \\\"\\\") {\\n\\t\\t\\tBoardData boardData = JsonConvert.DeserializeObject<BoardData>(boardString);\\n\\t\\t\\tgroups = boardData.groups.Select(groupData => {\\n\\t\\t\\t\\tList<Block> bs = groupData.blocks.Select(blockData => {\\n\\t\\t\\t\\t\\tBlock b = MakeBlock(blockData.pos.ToV3(), blockData.x, blockData.y, blockData.ci, true);\\n\\t\\t\\t\\t\\tb.gob.transform.eulerAngles = blockData.rot.ToV3();\\n\\t\\t\\t\\t\\treturn b;\\n\\t\\t\\t\\t}).ToList();\\n\\t\\t\\t\\tGob group = MakeGroup(groupData.pos.ToV3(), groupData.rot.ToV3(), bs);\\n\\t\\t\\t\\tBody2D body = group.Body2D();\\n\\t\\t\\t\\tbody.simulated = true;\\n\\t\\t\\t\\tbody.WakeUp();\\n\\t\\t\\t\\tbody.constraints = RigidbodyConstraints2D.None;\\n\\t\\t\\t\\treturn group;\\n\\t\\t\\t}).ToList();\\n\\t\\t}\\n\\t}\\n\\tvoid SaveBoard() {\\n\\t\\tList<GroupData> groupData = groups.Where(group => lastGroup != group).Select(group => {\\n\\t\\t\\tList<BlockData> blockData = GetBlocksInGroup(group).Select(block => {\\n\\t\\t\\t\\treturn new BlockData() {pos=new SerializedV3(block.gob.Pos()), rot=new SerializedV3(block.gob.transform.eulerAngles), x=block.x, y=block.y, ci=block.colorIndex};\\n\\t\\t\\t}).ToList();\\n\\t\\t\\treturn new GroupData() {pos=new SerializedV3(group.Pos()), rot=new SerializedV3(group.transform.eulerAngles), blocks=blockData};\\n\\t\\t}).ToList();\\n\\t\\tBoardData boardData = new BoardData() {groups=groupData};\\n\\n\\t\\tstring boardString = JsonConvert.SerializeObject(boardData);\\n\\t\\tUtil.String(\\\"board\\\", boardString);\\n\\t\\tshouldSaveBoard = false;\\n\\t}\\n\\tvoid SaveDock() {\\n\\t\\tstring dockString = String.Join(\\\",\\\", dockItems);\\n\\t\\tlog(dockString);\\n\\t\\tUtil.String(\\\"dock\\\", dockString);\\n\\t}\\n\\n\\t///////\\n\\t// INIT\\n\\t///////\\n\\tvoid HideTemplates() {\\n\\t\\tblockTemp.Off();\\n\\t\\tgroupTemp.Off();\\n\\t\\tpopTextTemp.Off();\\n\\t\\texplosionTemp.Off();\\n\\t\\twallTemp.Off();\\n\\t}\\n\\tvoid HideObjects() {\\n\\t\\t// ui\\n\\t\\trewardedItem.Off();\\n\\t\\tdraggableItem.Off();\\n\\t\\tsettingsPanel.Off();\\n\\t\\tgameOverPanel.Off();\\n\\t\\treviveHighScore.Off();\\n\\t}\\n\\tvoid MakeWalls() {\\n\\t\\tfloat bevelBuf = 0.3f;\\n\\t\\tfloat wallThickness = 10f;\\n\\n\\t\\tBounds b = board.SpriteRenderer().bounds;\\n\\t\\tb.Expand(-bevelBuf);\\n\\t\\tb.min = new v3(b.min.x, b.min.y, -1f);\\n\\t\\tb.max = new v3(b.max.x, b.max.y, 1f);\\n\\t\\tboardBounds = b;\\n\\n\\t\\tGob left = make(wallTemp);\\n\\t\\tleft.On();\\n\\t\\tleft.Pos(board.Pos() + v3.left * (b.extents.x + wallThickness*0.5f));\\n\\t\\tleft.gc<BoxCollider2D>().size = new v2(wallThickness, b.size.y*20f);\\n\\n\\t\\tGob right = make(wallTemp);\\n\\t\\tright.On();\\n\\t\\tright.Pos(board.Pos() + v3.right * (b.extents.x + wallThickness*0.5f));\\n\\t\\tright.gc<BoxCollider2D>().size = new v2(wallThickness, b.size.y*20f);\\n\\n\\t\\tGob bottom = make(wallTemp);\\n\\t\\tbottom.On();\\n\\t\\tbottom.name = \\\"floor\\\";\\n\\t\\tbottom.Pos(board.Pos() + v3.down * (b.extents.y + wallThickness*0.5f));\\n\\t\\tbottom.gc<BoxCollider2D>().size = new v2(b.size.x, wallThickness);\\n\\t}\\n\\tvoid Awake() {\\n\\t\\tHideTemplates();\\n\\t\\tHideObjects();\\n\\t\\tMakeWalls();\\n\\t}\\n\\tvoid Start() {\\n\\t\\t// cam\\n\\t\\tinitialCamPos = cam.gameObject.Pos();\\n\\t\\t\\n\\t\\t// level start\\n\\t\\tSpawnGroup();\\n\\n\\t\\t// base state\\n\\t\\tscore = 0;\\n\\t\\troundIndex = 0;\\n\\t\\tlastHighScore = Util.GInt(\\\"highScore\\\", 1);\\n\\t\\talive = true;\\n\\t\\thitHapticTimer = new Timer(0.05f, true);\\n\\t\\tclearHapticTimer = new Timer(0.05f, true);\\n\\n\\t\\t// load saved game\\n\\t\\tLoadGame();\\n\\n\\t\\t// derived start state\\n\\t\\tscoreGoal = startScoreGoal + scoreGoalIncrement*roundIndex;\\n\\n\\t\\t// UI\\n\\t\\troundNumber.Text().text = $\\\"Round {roundIndex+1}\\\";\\n\\t\\thighScore.Text().text = $\\\"{Util.GInt(\\\"highScore\\\", 1)}\\\";\\n\\t\\tif (Util.GBool(\\\"noads\\\", false)) {\\n\\t\\t\\tnoAdsSlot.Off();\\n\\t\\t\\tsettingsRemoveAdsRow.Off();\\n\\t\\t}\\n\\n\\t\\t// save\\n\\t\\tUtil.Bool(\\\"gameOver\\\", false);\\n\\t}\\n\\n\\t////////////\\n\\t// GAME LOOP\\n\\t////////////\\n\\tvoid PositionNextGroup(float x) {\\n\\t\\tfloat buf = 0.05f;\\n\\t\\tfloat minX = boardBounds.min.x+buf;\\n\\t\\tfloat maxX = boardBounds.max.x-buf;\\n\\n\\t\\t// drag positioning\\n\\t\\tv3 pos = new v3(x, dropY, 0f);\\n\\t\\tfloat hw = groupExtentX;\\n\\t\\tif (pos.x-hw < minX)\\n\\t\\t\\tpos.x = minX+hw;\\n\\t\\tif (pos.x+hw > maxX)\\n\\t\\t\\tpos.x = maxX-hw;\\n\\t\\tlastGroupPos = pos;\\n\\t\\tlastGroup.Pos(pos);\\n\\n\\t\\t// shadow shimmer\\n\\t\\tList<Block> bs = GetBlocksInGroup(lastGroup);\\n\\t\\tfor (int i = 0; i < bs.Count; i++) {\\n\\t\\t\\tBlock b = bs[i];\\n\\t\\t\\tfloat alpha = 0.1f + Mathf.PingPong(Time.time*0.2f+i*0.1f, 0.2f);\\n\\t\\t\\tColor c = b.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").SpriteRenderer().color.alpha(alpha);\\n\\t\\t\\tb.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").SpriteRenderer().color = c;\\n\\t\\t}\\n\\n\\t\\t// update undropped group max y until it's dropped\\n\\t\\tBounds lastGroupBounds = GetGroupBounds(lastGroup);\\n\\t\\tlastGroupMaxY = lastGroupBounds.max.y;//lastGroup.Pos().y+lastGroupBounds.max.y;\\n\\t}\\n\\tvoid DropNextGroup() {\\n\\t\\tIEnumerator _() {\\n\\t\\t\\twhile (lastGroup != null && lastGroup.transform.localScale != v3.one)\\n\\t\\t\\t\\tyield return new WaitForEndOfFrame();\\n\\n\\t\\t\\tif (lastGroup == null)\\n\\t\\t\\t\\tyield break;\\n\\n\\t\\t\\tBody2D body = lastGroup.Body2D();\\n\\t\\t\\tList<Block> bs = GetBlocksInGroup(lastGroup);\\n\\t\\t\\tbody.simulated = true;\\n\\t\\t\\tbody.WakeUp();\\n\\t\\t\\tbody.constraints = RigidbodyConstraints2D.None;\\n\\t\\t\\tbody.linearVelocity = v2.down * 5f;\\n\\n\\t\\t\\tlastGroup = null;\\n\\t\\t\\tTime.timeScale = 1f;\\n\\t\\t\\ttimeScale = 1f;\\n\\n\\t\\t\\t// shadow\\n\\t\\t\\tyield return Do(0.15f, 0f, 0.25f, Motion.SIN, alpha => {\\n\\t\\t\\t\\tforeach (Block b in bs) {\\n\\t\\t\\t\\t\\tif (b==null || b.gob==null || b.gob.Child(\\\"shadow\\\")==null || b.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\")==null)\\n\\t\\t\\t\\t\\t\\tcontinue;\\n\\t\\t\\t\\t\\tColor c = b.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").SpriteRenderer().color.alpha(alpha);\\n\\t\\t\\t\\t\\tb.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").SpriteRenderer().color = c;\\n\\t\\t\\t\\t}\\n\\t\\t\\t});\\n\\t\\t\\tforeach (Block b in bs) {\\n\\t\\t\\t\\tif (b==null || b.gob==null || b.gob.Child(\\\"shadow\\\")==null)\\n\\t\\t\\t\\t\\tcontinue;\\n\\t\\t\\t\\tb.gob.Child(\\\"shadow\\\").Off();\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tStartCoroutine(_());\\n\\t}\\n\\tvoid UnfreezeAllGroups() {\\n\\t\\tforeach (Block b in blocks) {\\n\\t\\t\\tGob g = b.gob.Parent();\\n\\t\\t\\tif (g != null) {\\n\\t\\t\\t\\tg.Body2D().constraints = RigidbodyConstraints2D.None;\\n\\t\\t\\t\\tg.Body2D().WakeUp();\\n\\t\\t\\t\\tg.Body2D().linearVelocity = g.gc<BlockGroup>().vel;\\n\\t\\t\\t}\\n\\t\\t}\\n\\t}\\n\\tvoid MovePops() {\\n\\t\\tList<PopText> toRemove = new();\\n\\t\\tforeach (PopText pop in popTexts) {\\n\\t\\t\\tif (pop.gob == null)\\n\\t\\t\\t\\ttoRemove.Add(pop);\\n\\t\\t\\telse\\n\\t\\t\\t\\tpop.gob.Pos(v3.Lerp(pop.gob.Pos(), pop.lerpPos, 0.25f));\\n\\t\\t}\\n\\t\\tforeach (PopText pop in toRemove)\\n\\t\\t\\tpopTexts.Remove(pop);\\n\\t}\\n\\tvoid FadePops() {\\n\\t\\tList<PopText> donePops = popTexts.Where(e => e.done).ToList();\\n\\t\\tforeach (PopText pop in donePops)\\n\\t\\t\\tpopTexts.Remove(pop);\\n\\t\\tforeach (PopText pop in donePops) {\\n\\t\\t\\tscoreToAdd += pop.val;\\n\\t\\t\\tUtil.Int(\\\"blocksCleared\\\", Util.GInt(\\\"blocksCleared\\\",0)+pop.val);\\n\\t\\t\\t\\n\\t\\t\\tIEnumerator SyncScore() {\\n\\t\\t\\t\\tDo(0f, 1f, 0.5f, Motion.COS, t => {\\n\\t\\t\\t\\t\\tif (pop!=null && pop.gob!=null)\\n\\t\\t\\t\\t\\t\\tpop.gob.transform.localScale = v3.Lerp(v3.one, v3.one*2f, t);\\n\\t\\t\\t\\t});\\n\\t\\t\\t\\tyield return new WaitForSeconds(0.25f);\\n\\t\\t\\t\\tDo(0f, 1f, 0.25f, Motion.SIN, t => {\\n\\t\\t\\t\\t\\tif (pop!=null && pop.gob!=null)\\n\\t\\t\\t\\t\\t\\tpop.gob.Text().color = Color.Lerp(Color.white, Color.white.alpha(0f), t);\\n\\t\\t\\t\\t});\\n\\t\\t\\t\\tyield return new WaitForSeconds(1f);\\n\\t\\t\\t\\tkill(pop.gob);\\n\\t\\t\\t}\\n\\t\\t\\tStartCoroutine(SyncScore());\\n\\t\\t}\\n\\t}\\n\\tvoid UpdateScore() {\\n\\t\\tif (scoreToAdd > 0) {\\n\\t\\t\\tscoreToAdd--;\\n\\t\\t\\tscore++;\\n\\t\\t\\tscoreSliderHandleScale = v3.one * 1.2f;\\n\\t\\t\\tUtil.Int(\\\"score\\\", score);\\n\\t\\t}\\n\\t\\telse {\\n\\t\\t\\tscoreSliderHandleScale = v3.one;\\n\\t\\t}\\n\\t\\tscoreText.text = \\\"\\\"+score;\\n\\t\\tscoreSlider.value = Lerp(scoreSlider.value, (float)score/scoreGoal, 0.5f);\\n\\t\\tscoreSliderHandle.transform.localScale = Lerp(scoreSliderHandle.transform.localScale, scoreSliderHandleScale, 0.15f);\\n\\t}\\n\\tvoid FitToGameView() {\\n\\t\\tv3[] gameViewCorners = new v3[4];\\n\\t\\treviveGameView.gc<RectTransform>().GetWorldCorners(gameViewCorners);\\n\\t\\tv3[] canvasCorners = new v3[4];\\n\\t\\tcanvas.gameObject.gc<RectTransform>().GetWorldCorners(canvasCorners);\\n\\t\\tv3[] safeCorners = new v3[4];\\n\\t\\tsafeArea.GetWorldCorners(safeCorners);\\n\\t\\tfloat canvasHeight = v3.Distance(canvasCorners[1], canvasCorners[0]);\\n\\t\\tfloat safeHeight = v3.Distance(safeCorners[1], safeCorners[0]);\\n\\t\\tfloat gameViewHeight = v3.Distance(gameViewCorners[1], gameViewCorners[0]);\\n\\n\\t\\tfloat gameMinY = boardBounds.min.y;\\n\\t\\tfloat gameMaxY = GetMaxGroupY(true);\\n\\t\\tfloat gameMidY = (gameMaxY+gameMinY)/2f;\\n\\t\\tfloat gameHeight = gameMaxY-gameMinY;\\n\\n\\t\\tfloat camSafeSize = safeHeight/gameViewHeight * gameHeight * 0.5f * (canvasHeight/safeHeight);\\n\\t\\tDo(cam.orthographicSize, camSafeSize, 0.5f, Motion.SMOOTH, size => cam.orthographicSize = size);\\n\\n\\t\\tv3 camPos = cam.gameObject.Pos();\\n\\t\\tfloat gameViewOffset = ((reviveGameView.RectTransform().anchoredPosition.y+safeArea.rect.height*0.5f) * ((camSafeSize*2f)/safeArea.rect.height));\\n\\t\\tcamPos.y = gameMidY - gameViewOffset;\\n\\t\\tDo(cam.gameObject.Pos(), camPos, 0.5f, Motion.SMOOTH, pos => cam.gameObject.Pos(pos));\\n\\t}\\n\\tvoid Fail(List<Block> blocksAbove) {\\n\\t\\talive = false;\\n\\t\\tforeach (Gob g in groups) {\\n\\t\\t\\tg.Body2D().constraints = RigidbodyConstraints2D.FreezeAll;\\n\\t\\t}\\n\\n\\t\\tfloat maxY = GetMaxGroupY();\\n\\t\\tblocks = blocks.OrderBy(b => v2.Distance(b.gob.Pos(), v2.up*maxY)).ToList();\\n\\t\\tDo(maxY, boardBounds.min.y, 0.5f, Motion.COS, y => {\\n\\t\\t\\tblocks.Where(b => b.gob.Pos().y > y).ToList().ForEach(b => {\\n\\t\\t\\t\\tb.gob.SpriteRenderer().material.color = Color.white;\\n\\t\\t\\t\\tif (b.gob.Child(\\\"shadow\\\").activeSelf)\\n\\t\\t\\t\\t\\tb.gob.Child(\\\"shadow\\\").Child(\\\"flame\\\").SpriteRenderer().color = Color.white.alpha(0.1f);\\n\\t\\t\\t});\\n\\t\\t});\\n\\n\\t\\tbool newHighScore = Util.GInt(\\\"highScore\\\",1) > lastHighScore;\\n\\t\\t\\n\\t\\t// cam\\n\\t\\tFitToGameView();\\n\\t\\t\\n\\t\\t// slider\\n\\t\\tif (newHighScore)\\n\\t\\t\\tscoreSlider.gameObject.Off();\\n\\t\\telse\\n\\t\\t\\tDo(scoreSlider.gameObject.gc<RectTransform>().anchoredPosition, gameOverPanel.Child(\\\"slider pos\\\").gc<RectTransform>().anchoredPosition, 0.3f, Motion.SMOOTH, pos => scoreSlider.gameObject.gc<RectTransform>().anchoredPosition = pos);\\n\\n\\t\\t// header\\n\\t\\theader.Off();\\n\\n\\t\\t// dock\\n\\t\\tdock.Off();\\n\\t\\trewardedItem.Off();\\n\\t\\tdraggableItem.Off();\\n\\n\\t\\tIEnumerator _() {\\n\\t\\t\\tyield return wait(.25f);\\n\\t\\t\\tShowGameOverPanel(newHighScore);\\n\\t\\t\\tDo(v3.one, v3.one*1.5f, 0.2f, Motion.COS, scale => scoreSliderHandle.transform.localScale = scale);\\n\\t\\t}\\n\\t\\tDo(_());\\n\\n\\t\\t// save\\n\\t\\tUtil.Bool(\\\"gameOver\\\", true);\\n\\t}\\n\\tGob GetEmptySlot() {\\n\\t\\t// dockSlots.Shuffle();\\n\\t\\tGob slot = dockSlots.Random();\\n\\t\\tforeach (Gob s in dockSlots) {\\n\\t\\t\\tif (!s.Child(\\\"item\\\").activeSelf)\\n\\t\\t\\t\\treturn s;\\n\\t\\t}\\n\\t\\treturn slot;\\n\\t}\\n\\tvoid RewindSlider() {\\n\\t\\tscoreText.text = \\\"0\\\";\\n\\t\\tDo(1f, 0f, 1f, Motion.SIN, t => scoreSlider.value = t, () => {\\n\\t\\t\\tbetweenRounds = false;\\n\\t\\t\\tscoreToAdd = 0;\\n\\n\\t\\t\\t// round number\\n\\t\\t\\troundNumber.Text().text = $\\\"Round {roundIndex+1}\\\";\\n\\n\\t\\t\\t// high score\\n\\t\\t\\tint currentHighScore = Util.GInt(\\\"highScore\\\", 1);\\n\\t\\t\\thighScore.Text().text = $\\\"{currentHighScore}\\\";\\n\\t\\t\\tbool newHighest = currentHighScore > lastHighScore;\\n\\t\\t\\thighScore.Parent().Image().color = newHighest ? goldColor : paleColor;\\n\\t\\t\\thighScore.Text().color = newHighest ? goldColor : paleColor;\\n\\t\\t});\\n\\t}\\n\\tvoid MeetGoal() {\\n\\t\\tbetweenRounds = true;\\n\\t\\t\\n\\t\\t// reset goal\\n\\t\\tscore = 0;\\n\\t\\troundIndex++;\\n\\t\\tscoreGoal = startScoreGoal + roundIndex*scoreGoalIncrement;\\n\\t\\tUtil.Int(\\\"score\\\", score);\\n\\t\\tUtil.Int(\\\"roundIndex\\\", roundIndex);\\n\\t\\tif (roundIndex+1 > Util.GInt(\\\"highScore\\\", 1))\\n\\t\\t\\tUtil.Int(\\\"highScore\\\", roundIndex+1);\\n\\n\\t\\t// reward\\n\\t\\tbool getReward = randf < 0.5f;\\n\\t\\tgetReward = true;\\n\\t\\tif (getReward) {\\n\\t\\t\\t// random item\\n\\t\\t\\tList<string> itemTypes = new() {\\\"bomb\\\", \\\"bucket\\\", \\\"bucket\\\", \\\"bucket\\\"};\\n\\t\\t\\tList<string> itemsWithColors = new() {\\\"bucket\\\"};\\n\\t\\t\\titemType = itemTypes.Random();\\n\\t\\t\\tif (itemsWithColors.Contains(itemType))\\n\\t\\t\\t\\titemColor = Rand(6);\\n\\t\\t\\telse \\n\\t\\t\\t\\titemColor = -1;\\n\\t\\t\\tstring itemName = itemType;\\n\\t\\t\\tif (itemColor > -1)\\n\\t\\t\\t\\titemName += \\\"_\\\"+colorNames[itemColor];\\n\\t\\t\\tSprite itemSprite = LoadItemSprite(itemName);\\n\\t\\t\\trewardedItem.Child(\\\"item\\\").Image().sprite = itemSprite;\\n\\n\\t\\t\\tscoreSliderHandle.Child(\\\"text\\\").Off();\\n\\t\\t\\tscoreSliderHandle.Child(\\\"item\\\").Child(\\\"item\\\").Image().sprite = itemSprite;\\n\\t\\t\\tscoreSliderHandle.Child(\\\"item\\\").On();\\n\\t\\t\\tDo(v3.one, v3.one*2f, 0.5f, Motion.COS, scale => {\\n\\t\\t\\t\\tscoreSliderHandle.transform.localScale = scale;\\n\\t\\t\\t}, () => {\\n\\t\\t\\t\\tDo(v3.one*2f, v3.one*1.5f, 1f, Motion.SIN, scale => {\\n\\t\\t\\t\\t\\tscoreSliderHandle.transform.localScale = scale;\\n\\t\\t\\t\\t}, () => {\\n\\t\\t\\t\\t\\tDo(v3.one*1.5f, v3.one, 0.25f, Motion.SMOOTH, scale => scoreSliderHandle.transform.localScale = scale);\\n\\n\\t\\t\\t\\t\\tscoreSliderHandle.Child(\\\"text\\\").On();\\n\\t\\t\\t\\t\\tscoreSliderHandle.Child(\\\"item\\\").Off();\\n\\n\\t\\t\\t\\t\\trewardedItem.On();\\n\\t\\t\\t\\t\\t\\n\\t\\t\\t\\t\\t// scale down item\\n\\t\\t\\t\\t\\tDo(v3.one, v3.one*0.6f, 0.5f, Motion.SMOOTH, scale => rewardedItem.transform.localScale = scale);\\n\\n\\t\\t\\t\\t\\t// move item to slot\\n\\t\\t\\t\\t\\tGob slot = GetEmptySlot();\\n\\t\\t\\t\\t\\tint slotIndex = dockSlots.IndexOf(slot);\\n\\t\\t\\t\\t\\tDo(scoreSliderHandle.Pos(), slot.Pos(), 0.5f, Motion.SMOOTH, pos => {\\n\\t\\t\\t\\t\\t\\trewardedItem.Pos(pos);\\n\\t\\t\\t\\t\\t}, () => {\\n\\t\\t\\t\\t\\t\\trewardedItem.Off();\\n\\t\\t\\t\\t\\t\\tslot.Child(\\\"item\\\").Image().sprite = itemSprite;\\n\\t\\t\\t\\t\\t\\tslot.Child(\\\"item\\\").On();\\n\\n\\t\\t\\t\\t\\t\\t// save\\n\\t\\t\\t\\t\\t\\tdockItems[slotIndex] = itemName;\\n\\t\\t\\t\\t\\t\\tSaveDock();\\n\\n\\t\\t\\t\\t\\t\\tRewindSlider();\\n\\t\\t\\t\\t\\t});\\n\\t\\t\\t\\t});\\n\\t\\t\\t});\\n\\t\\t}\\n\\t\\telse {\\n\\t\\t\\tRewindSlider();\\n\\t\\t}\\n\\t}\\n\\tvoid CheckForFail() {\\n\\t\\tfloat bpm = 2.133f;\\n\\t\\tfloat freq = bpm/2f;\\n\\t\\tfloat flashThresh = 1f;\\n\\t\\tfloat fastThresh = flashThresh+2f;\\n\\t\\tfloat fasterThresh = flashThresh+4f;\\n\\t\\tfloat deathThresh = flashThresh+5f;\\n\\t\\tbool dying = dyingBlocks.Count > 0;\\n\\t\\tList<Gob> groupsAbove = new();\\n\\t\\tList<Block> blocksAbove = new();\\n\\t\\tif (AnyGroupsAboveBoard(ref groupsAbove)) {\\n\\t\\t\\tblocksAbove = GetBlocksAboveBoard(groupsAbove);\\n\\n\\t\\t\\tif (!dying)\\n\\t\\t\\t\\ttimeAboveBoard += Time.deltaTime;\\n\\n\\t\\t\\t// flash\\n\\t\\t\\tif (timeAboveBoard > flashThresh) {\\n\\t\\t\\t\\tfloat t = Time.time;//timeAboveBoard-flashThresh;\\n\\t\\t\\t\\tif (timeAboveBoard > fasterThresh) {\\n\\t\\t\\t\\t\\tfreq *= 4f;\\n\\t\\t\\t\\t\\tt = t-fasterThresh;\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tif (timeAboveBoard > fastThresh) {\\n\\t\\t\\t\\t\\tfreq *= 2f;\\n\\t\\t\\t\\t\\tt = t-fastThresh;\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tfloat a = 0.5f + (1f + Mathf.Cos(freq*t*Mathf.PI*2f))*0.5f*0.5f;\\n\\t\\t\\t\\tforeach (Block b in blocksAbove) {\\n\\t\\t\\t\\t\\tGob g = b.gob.Parent();\\n\\t\\t\\t\\t\\tforeach (Block b1 in GetBlocksInGroup(g)) {\\n\\t\\t\\t\\t\\t\\tb1.gob.SpriteRenderer().material.color = b1.color.alpha(a);\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\n\\t\\t\\t// death\\n\\t\\t\\tif (timeAboveBoard > deathThresh) {\\n\\t\\t\\t\\tFail(blocksAbove);\\n\\t\\t\\t\\treturn;\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\telse {\\n\\t\\t\\ttimeAboveBoard = 0f;\\n\\t\\t}\\n\\n\\t\\t// recolor blocks below, deescalate flashers\\n\\t\\tforeach (Block b in blocks) {\\n\\t\\t\\tBody2D body = b.gob.Parent().Body2D();\\n\\t\\t\\tif (!blocksAbove.Contains(b))\\n\\t\\t\\t\\tb.gob.SpriteRenderer().material.color = b.color;\\n\\t\\t}\\n\\t}\\n\\tvoid ShowPraise() {\\n\\t\\tint groupsKilled = dyingGroupCount;\\n\\t\\tint multiplier = groupsKilled/2;\\n\\t\\tIEnumerator Praise() {\\n\\t\\t\\tvar pop = make(popTextTemp);\\n\\t\\t\\tpop.On();\\n\\t\\t\\tint praiseIndex = clamp(multiplier-3, 0, praises.Count-1);\\n\\t\\t\\tint scoreAdd = multiplier*10;\\n\\t\\t\\tscoreToAdd += scoreAdd;\\n\\t\\t\\tpop.Text().text = $\\\"<b>{praises[praiseIndex]}</b>\\\\n+{scoreAdd}\\\";\\n\\t\\t\\tpop.Pos(lastCollisionPos);\\n\\n\\t\\t\\tvar explosion = make(explosionTemp);\\n\\t\\t\\texplosion.Pos(lastCollisionPos);\\n\\t\\t\\texplosion.On();\\n\\n\\t\\t\\t// pop in\\n\\t\\t\\tyield return Do(v3.zero, v3.one*1.5f, 0.2f, Motion.COS, scale => {\\n\\t\\t\\t\\tpop.transform.localScale = scale;\\n\\t\\t\\t});\\n\\t\\t\\tyield return Do(v3.one*1.5f, v3.one, 1f, Motion.SIN, scale => {\\n\\t\\t\\t\\tpop.transform.localScale = scale;\\n\\t\\t\\t});\\n\\t\\t\\t\\t\\n\\t\\t\\t// fade away\\n\\t\\t\\tDo(0f, 1f, 0.5f, Motion.COS, t => {\\n\\t\\t\\t\\tpop.transform.localScale = v3.Lerp(v3.one, v3.one*2f, t);\\n\\t\\t\\t});\\n\\t\\t\\tyield return new WaitForSeconds(0.25f);\\n\\t\\t\\tDo(0f, 1f, 0.25f, Motion.SIN, t => {\\n\\t\\t\\t\\tpop.Text().color = Color.Lerp(Color.white, Color.white.alpha(0f), t);\\n\\t\\t\\t});\\n\\t\\t\\tyield return new WaitForSeconds(1f);\\n\\t\\t\\tkill(pop);\\n\\t\\t}\\n\\t\\tif (multiplier >= 3) {\\n\\t\\t\\tStartCoroutine(Praise());\\n\\t\\t}\\n\\t}\\n\\tvoid SelectItem(Gob dockSlot) {\\n\\t\\tGob item = dockSlot.Child(\\\"item\\\");\\n\\t\\tif (!item.activeSelf)\\n\\t\\t\\treturn;\\n\\n\\t\\tdockSlot.Child(\\\"item\\\").Off();\\n\\t\\t\\n\\t\\tv3 center = ui2WorldPos(dockSlot);\\n\\t\\tdraggableItem.Pos(center);\\n\\t\\tdraggableItem.Child(\\\"item\\\").Image().sprite = item.Image().sprite;\\n\\t\\tdraggableItem.On();\\n\\t\\tdraggableItem.transform.localScale = v3.one * 0.6f;\\n\\n\\t\\tactiveDockSlot = dockSlot;\\n\\t\\tdraggingItem = true;\\n\\t}\\n\\tvoid DragItem() {\\n\\t\\tstring[] item = dockItems[dockSlots.IndexOf(activeDockSlot)].Split('_');\\n\\t\\tstring itemType = item[0];\\n\\t\\tif (Input.GetMouseButton(0)) {\\n\\t\\t\\t// translate\\n\\t\\t\\tfloat yOffset = refHeight * 0.1f;\\n\\t\\t\\tv3 pos = draggableItem.RectTransform().anchoredPosition;\\n\\t\\t\\tfloat screenScale = refHeight/Screen.height;\\n\\t\\t\\tv3 toPos = new v3(Input.mousePosition.x, Input.mousePosition.y, 0f) * screenScale;\\n\\t\\t\\ttoPos += v3.up * yOffset;\\n\\t\\t\\tdraggableItem.RectTransform().anchoredPosition = Lerp(pos, toPos, 0.5f);\\n\\n\\t\\t\\t// pulse\\n\\t\\t\\tif (itemType == \\\"bomb\\\") {\\n\\t\\t\\t\\tdraggableItem.transform.localScale = Lerp(draggableItem.transform.localScale, v3.one, 0.5f);\\n\\t\\t\\t\\tv2 itemPos = (v2)ui2WorldPos(draggableItem);\\n\\t\\t\\t\\tbool withinBoard = boardBounds.Contains(itemPos);\\n\\t\\t\\t\\tfloat width = 0f;\\n\\t\\t\\t\\tif (withinBoard) {\\n\\t\\t\\t\\t\\tfloat toLeft = Mathf.Abs(itemPos.x-(boardBounds.center.x-boardBounds.extents.x));\\n\\t\\t\\t\\t\\tfloat toRight = Mathf.Abs(itemPos.x-(boardBounds.center.x+boardBounds.extents.x));\\n\\t\\t\\t\\t\\tfloat toTop = Mathf.Abs(itemPos.y-(boardBounds.center.y+boardBounds.extents.y));\\n\\t\\t\\t\\t\\tfloat toBot = Mathf.Abs(itemPos.y-(boardBounds.center.y-boardBounds.extents.y));\\n\\t\\t\\t\\t\\tfloat closestDist = min(toLeft, min(toRight, min(toTop,toBot)));\\n\\t\\t\\t\\t\\twidth = min(3f, closestDist) * 2f + 0.25f;\\n\\t\\t\\t\\t}\\n\\t\\t\\t\\tdraggableItem.Child(\\\"radius\\\").transform.localScale = v3.one * width;\\n\\t\\t\\t\\tdraggableItem.Child(\\\"radius\\\").On();\\n\\t\\t\\t}\\n\\t\\t\\telse if (itemType == \\\"bucket\\\") {\\n\\t\\t\\t\\tdraggableItem.Child(\\\"radius\\\").Off();\\n\\t\\t\\t\\t\\n\\t\\t\\t\\t// reset\\n\\t\\t\\t\\tforeach (Block b in blocks) {\\n\\t\\t\\t\\t\\tb.color = blockMats[b.colorIndex].color;\\n\\t\\t\\t\\t\\tb.gob.SpriteRenderer().material.color = b.color;\\n\\t\\t\\t\\t}\\n\\n\\t\\t\\t\\t// preview item\\n\\t\\t\\t\\tv2 dropPos = (v2)ui2WorldPos(draggableItem);\\n\\t\\t\\t\\tbool withinBoard = boardBounds.Contains(dropPos);\\n\\t\\t\\t\\tif (withinBoard) {\\n\\t\\t\\t\\t\\tint colorIndex = Array.IndexOf(colorNames, item[1]);\\n\\t\\t\\t\\t\\tBlock nearestBlock = blocks.OrderBy(b => {\\n\\t\\t\\t\\t\\t\\treturn v2.Distance(b.gob.Pos(), dropPos);\\n\\t\\t\\t\\t\\t}).First();\\n\\t\\t\\t\\t\\tif (v2.Distance(nearestBlock.gob.Pos(), dropPos) < 1f)\\n\\t\\t\\t\\t\\t\\tBucketFill(nearestBlock.gob, colorIndex, true);\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif (Input.GetMouseButtonUp(0))\\n\\t\\t\\tDropItem();\\n\\t}\\n\\tvoid DropItem() {\\n\\t\\tv2 dropPos = (v2)ui2WorldPos(draggableItem);\\n\\t\\tbool withinBoard = boardBounds.Contains(dropPos);\\n\\t\\tif (withinBoard) {\\n\\t\\t\\t// apply item\\n\\t\\t\\tstring[] item = dockItems[dockSlots.IndexOf(activeDockSlot)].Split('_');\\n\\t\\t\\tstring itemType = item[0];\\n\\t\\t\\tif (itemType == \\\"bucket\\\") {\\n\\t\\t\\t\\tint colorIndex = Array.IndexOf(colorNames, item[1]);\\n\\t\\t\\t\\tBlock nearestBlock = blocks.OrderBy(b => {\\n\\t\\t\\t\\t\\treturn v2.Distance(b.gob.Pos(), dropPos);\\n\\t\\t\\t\\t}).First();\\n\\t\\t\\t\\tBucketFill(nearestBlock.gob, colorIndex);\\n\\t\\t\\t}\\n\\t\\t\\telse if (itemType == \\\"bomb\\\") {\\n\\t\\t\\t\\tfloat radius = draggableItem.Child(\\\"radius\\\").transform.localScale.x * 0.5f;\\n\\t\\t\\t\\tList<Block> blocksInLastGroup = GetBlocksInGroup(lastGroup);\\n\\t\\t\\t\\tList<Block> blocksInRadius = blocks.Where(b => {\\n\\t\\t\\t\\t\\treturn v2.Distance(b.gob.Pos(), dropPos) <= radius\\n\\t\\t\\t\\t\\t\\t&& !blocksInLastGroup.Contains(b)\\n\\t\\t\\t\\t\\t\\t/*b.colorIndex == 0 &&*/\\n\\t\\t\\t\\t\\t\\t;\\n\\t\\t\\t\\t}).ToList();\\n\\t\\t\\t\\tblocksInRadius.ForEach(b => {\\n\\t\\t\\t\\t\\tKillAdjacent(b.gob, b.gob.Pos());\\n\\t\\t\\t\\t});\\n\\n\\t\\t\\t\\t// explosion force\\n\\t\\t\\t\\tforeach (Gob group in groups) {\\n\\t\\t\\t\\t\\tif (group != lastGroup) {\\n\\t\\t\\t\\t\\t\\tfloat dist = ((v2)group.Pos()-dropPos).magnitude;\\n\\t\\t\\t\\t\\t\\tv2 dir = ((v2)group.Pos()-dropPos+v2.up).normalized;\\n\\t\\t\\t\\t\\t\\tgroup.Body2D().AddForce(dir * 300f, ForceMode2D.Impulse);\\n\\t\\t\\t\\t\\t}\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\n\\t\\t\\tdraggableItem.Off();\\n\\n\\t\\t\\t// save\\n\\t\\t\\tdockItems[dockSlots.IndexOf(activeDockSlot)] = \\\"_\\\";\\n\\t\\t\\tSaveDock();\\n\\t\\t}\\n\\t\\telse {\\n\\t\\t\\t// back to dock\\n\\t\\t\\tGob slot = activeDockSlot;\\n\\t\\t\\tv3 start = draggableItem.Pos();\\n\\t\\t\\tv3 stop = slot.Pos();\\n\\t\\t\\tDo(0f, 1f, 0.2f, Motion.COS,\\n\\t\\t\\tt => {\\n\\t\\t\\t\\tdraggableItem.Pos(Lerp(start, stop, t));\\n\\t\\t\\t\\tdraggableItem.transform.localScale = Lerp(v3.one, v3.one*0.6f, t);\\n\\t\\t\\t},\\n\\t\\t\\t() => {\\n\\t\\t\\t\\tdraggableItem.Off();\\n\\t\\t\\t\\tslot.Child(\\\"item\\\").On();\\n\\t\\t\\t});\\n\\t\\t}\\n\\t\\tdraggingItem = false;\\n\\t\\tactiveDockSlot = null;\\n\\t}\\n\\tvoid VLerpCam() {\\n\\t\\tif (paused)\\n\\t\\t\\tcam.gameObject.Pos(Lerp(cam.gameObject.Pos(), initialCamPos, 0.5f));\\n\\t\\telse {\\n\\t\\t\\tv3[] sliderCorners = new v3[4];\\n\\t\\t\\tscoreSlider.gameObject.gc<RectTransform>().GetWorldCorners(sliderCorners);\\n\\t\\t\\tv3[] canvasCorners = new v3[4];\\n\\t\\t\\tcanvas.gameObject.gc<RectTransform>().GetWorldCorners(canvasCorners);\\n\\t\\t\\tfloat headerHeight = canvasCorners[1].y-sliderCorners[0].y;\\n\\t\\t\\tfloat screenHeight = canvasCorners[1].y-canvasCorners[0].y;\\n\\t\\t\\t\\n\\t\\t\\tfloat maxY = max(lastGroupMaxY, GetMaxGroupY(true));\\n\\t\\t\\tv3 camPos = cam.gameObject.Pos();\\n\\t\\t\\tv3 toPos = camPos; toPos.y = maxY-(screenHeight*0.5f-headerHeight);\\n\\t\\t\\tv3 zeroPos = camPos; zeroPos.y = 0f;\\n\\t\\t\\tif (toPos.y > 0f)\\n\\t\\t\\t\\tcam.gameObject.Pos(Lerp(camPos, toPos, 0.05f));\\n\\t\\t\\telse\\n\\t\\t\\t\\tcam.gameObject.Pos(Lerp(camPos, zeroPos, 0.1f));\\n\\t\\t}\\n\\t}\\n\\tvoid Simulate() {\\n\\t\\tfloat lastGroupX = lastGroup != null ? lastGroup.Pos().x : 0f;\\n\\t\\t\\n\\t\\t// float next group over highest dropped group\\n\\t\\tif (lastGroup != null) {\\n\\t\\t\\tBounds groupBounds = GetGroupBounds(lastGroup);\\n\\t\\t\\tfloat maxGroupY = GetMaxGroupY();\\n\\t\\t\\tfloat vbuf = 0.5f;\\n\\t\\t\\tfloat topY = max(board.Pos().y+boardBounds.extents.y, maxGroupY);\\n\\t\\t\\tdropY = topY + groupBounds.extents.y + vbuf;\\n\\t\\t}\\n\\n\\t\\t// drag next group\\n\\t\\tif (Input.GetMouseButton(0) && !draggingItem && !hitUI) {\\n\\t\\t\\tif (lastGroup != null) {\\n\\t\\t\\t\\tvar hit = Raycast(cam.ScreenPointToRay(Input.mousePosition), 100f, 6);\\n\\t\\t\\t\\tif (hit != null)\\n\\t\\t\\t\\t\\tlastGroupX = hit.point.x;\\n\\t\\t\\t}\\n\\t\\t}\\n\\n\\t\\t// position next group\\n\\t\\tif (lastGroup != null) {\\n\\t\\t\\tPositionNextGroup(lastGroupX);\\n\\t\\t}\\n\\n\\t\\t// drop next group\\n\\t\\tif (Input.GetMouseButtonUp(0) && !draggingItem && !hitUI) {\\n\\t\\t\\tif (lastGroup != null)\\n\\t\\t\\t\\tDropNextGroup();\\n\\t\\t}\\n\\n\\t\\t// drag item\\n\\t\\tif (draggingItem)\\n\\t\\t\\tDragItem();\\n\\n\\t\\t// speed up deaths\\n\\t\\tif (dyingGroupCount > 0)\\n\\t\\t\\tdyingGroupTimer += Time.deltaTime;\\n\\t\\tif (dyingGroupTimer > dyingGroupDur) {\\n\\t\\t\\ttimeScale = 1f;\\n\\t\\t\\tTime.timeScale = 1f;\\n\\n\\t\\t\\tShowPraise();\\n\\t\\t\\tdyingGroupTimer = 0f;\\n\\t\\t\\tdyingGroupCount = 0;\\n\\t\\t}\\n\\n\\t\\t// unfreeze after all dying blocks die\\n\\t\\tif (lastDyingBlockCount > 0 && dyingBlocks.Count == 0) {\\n\\t\\t\\tUnfreezeAllGroups();\\n\\t\\t\\tFadePops();\\n\\t\\t}\\n\\t\\tlastDyingBlockCount = dyingBlocks.Count;\\n\\n\\t\\t// check for win\\n\\t\\tif (score >= scoreGoal) {\\n\\t\\t\\tMeetGoal();\\n\\t\\t\\treturn;\\n\\t\\t}\\n\\n\\t\\t// check for fail\\n\\t\\tCheckForFail();\\n\\n\\t\\t// reset end of frame\\n\\t\\tif (!Input.GetMouseButton(0))\\n\\t\\t\\thitUI = false;\\n\\t}\\n\\tvoid Update() {\\n\\t\\tif (paused)\\n\\t\\t\\treturn;\\n\\n\\t\\t// timers\\n\\t\\tTimer.UpdateAll(Time.deltaTime);\\n\\n\\t\\tif (alive)\\n\\t\\t\\tSimulate();\\n\\t}\\n\\tvoid LateUpdate() {\\n\\t\\tif (alive) {\\n\\t\\t\\t// cam y\\n\\t\\t\\tVLerpCam();\\n\\n\\t\\t\\t// time\\n\\t\\t\\tif (Ads.IsShowingAd())\\n\\t\\t\\t\\tTime.timeScale = 0f;\\n\\t\\t\\telse\\n\\t\\t\\t\\tTime.timeScale = Lerp(Time.timeScale, timeScale, 0.05f);\\n\\t\\t\\t\\n\\t\\t\\t// popup texts\\n\\t\\t\\tMovePops();\\n\\n\\t\\t\\t// score\\n\\t\\t\\tif (!betweenRounds)\\n\\t\\t\\t\\tUpdateScore();\\n\\t\\t\\t\\n\\t\\t\\t// save\\n\\t\\t\\tif (shouldSaveBoard)\\n\\t\\t\\t\\tSaveBoard();\\n\\t\\t}\\n\\t}\\n}\",\"selection\":{\"ranges\":[{\"anchor\":0,\"head\":0}],\"main\":0},\"fold\":[]}";