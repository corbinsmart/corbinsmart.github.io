export default "{\"doc\":\"using System.Collections;\\nusing System.Collections.Generic;\\nusing UnityEngine;\\nusing System.Linq;\\nusing UnityEngine.SceneManagement;\\n\\nusing v2 = UnityEngine.Vector2;\\nusing v3 = UnityEngine.Vector3;\\nusing Gob = UnityEngine.GameObject;\\n\\npublic class Tangram : MonoPlus {\\n    /////////////\\n    // COMPONENTS\\n    /////////////\\n    public Camera cam;\\n    public Gob canvasGob;\\n    public Gob boardBounds;\\n    public List<Gob> pieces;\\n    public Piece boardPiece;\\n    public List<Color> pieceColors;\\n    public Material ghostMat;\\n    public float maxDist;\\n    public float dropDist;\\n    \\n    ////////\\n    // DEBUG\\n    ////////\\n    List<Gob> trash = new();\\n    void DrawBounds(Bounds b, float dur=0f) {\\n        v3 min = b.min; min.y = 0f;\\n        v3 max = b.max; max.y = 0f;\\n        Debug.DrawLine(min, new v3(min.x, 0f, max.z), Color.green, dur);\\n        Debug.DrawLine(new v3(min.x, 0f, max.z), max, Color.green, dur);\\n        Debug.DrawLine(max, new v3(max.x, 0f, min.z), Color.green, dur);\\n        Debug.DrawLine(new v3(max.x, 0f, min.z), min, Color.green, dur);\\n    }\\n\\n    ////////\\n    // STATE\\n    ////////\\n    List<List<(int,int)>> allTris;\\n    List<Piece> placedPieces = new();\\n    Gob selectedPiece = null;\\n    Gob selectedPieceGhost = null;\\n    v3 mouseDownPos = v2.zero;\\n    float dragDist = 0f;\\n    v3 selectionOffset = v3.zero;\\n    bool gameOver = false;\\n    Bounds boardB;\\n\\n    ////////////\\n    // UTILITIES\\n    ////////////\\n    float lerpdt(float lambda, float dt) {\\n        return 1f - Mathf.Exp(-lambda * dt);\\n    }\\n    bool IsPointInPolygon(List<v3> polygon, v3 point) {\\n        bool result = false;\\n        var a = polygon.Last();\\n        foreach (var b in polygon) {\\n            if ((b.x == point.x) && (b.z == point.z))\\n                return true;\\n\\n            if ((b.z == a.z) && (point.z == a.z)) {\\n                if ((a.x <= point.x) && (point.x <= b.x))\\n                    return true;\\n\\n                if ((b.x <= point.x) && (point.x <= a.x))\\n                    return true;\\n            }\\n\\n            if ((b.z < point.z) && (a.z >= point.z) || (a.z < point.z) && (b.z >= point.z)) {\\n                if (b.x + (point.z - b.z) / (a.z - b.z) * (a.x - b.x) <= point.x)\\n                    result = !result;\\n            }\\n            a = b;\\n        }\\n        return result;\\n    }\\n    v3 BoardPosToWorldPos(v2 boardPos) {\\n        return new v3(-2f+boardPos.x, 0f, -2f+boardPos.y);\\n    }\\n    v2 WorldPosToBoardPos(v3 worldPos) {\\n        return new v2(Mathf.FloorToInt(2f+worldPos.x), Mathf.FloorToInt(2f+worldPos.z));\\n    }\\n    v3 TriPosToWorldPos(float tx, float ty) {\\n        return new v3(-2f + 0f + tx * (4f/12f), 0f, -2f + 0f + ty * (4f/12f));\\n    }\\n    bool IsPointOnBoard(v2 boardPoint) {\\n        int x = Mathf.FloorToInt(boardPoint.x);\\n        int y = Mathf.FloorToInt(boardPoint.y);\\n        return 0 <= x && x <= 4\\n            && 0 <= y && y <= 4;\\n    }\\n    bool PtsEqual((int,int) p1, (int,int) p2) {\\n        return p1.Item1 == p2.Item1 && p1.Item2 == p2.Item2;\\n    }\\n    bool TrisEqual(List<(int,int)> t1, List<(int,int)> t2) {\\n        for (int i = 0; i < 3; i++) {\\n            if (!PtsEqual(t1[i], t2[i]))\\n                return false;\\n        }\\n        return true;\\n    }\\n    List<List<(int,int)>> GetTris(List<v3> points) {\\n        return allTris.Where(tri => {\\n            float cx = (tri[0].Item1 + tri[1].Item1 + tri[2].Item1) / 3f;\\n            float cy = (tri[0].Item2 + tri[1].Item2 + tri[2].Item2) / 3f;\\n            v3 pos = TriPosToWorldPos(cx, cy);\\n            return IsPointInPolygon(points, pos);\\n        }).ToList();\\n    }\\n    bool IsPieceOverlapping(List<List<(int,int)>> occupiedTris, List<List<(int,int)>> pieceTris) {\\n        for (int i = 0; i < occupiedTris.Count; i++) {\\n            for (int j = 0; j < pieceTris.Count; j++) {\\n                if (TrisEqual(occupiedTris[i], pieceTris[j]))\\n                    return true;\\n            }\\n        }\\n        return false;\\n    }\\n    List<List<(int,int)>> GetOccupiedTris() {\\n        return placedPieces.SelectMany(piece => {\\n            v3 pos = piece.gameObject.Pos();\\n            v2 boardPoint = WorldPosToBoardPos(pos);\\n            var translatedPts = GetTranslatedPoints(piece, boardPoint);\\n            var verts = piece.windingOrder.Select(ind => BoardPosToWorldPos(translatedPts[ind])).ToList();\\n            return GetTris(verts);\\n        }).ToList();\\n    }\\n    List<v2> GetTranslatedPoints(Piece p, v2 boardPoint) {\\n        return p.points.Select(point => boardPoint + point).ToList();\\n    }\\n    List<v2> GetValidPoints(Gob pieceGob) {\\n        List<v2> allPoints = boardPiece.points;\\n        Piece piece = pieceGob.gc<Piece>();\\n\\n        var occupiedTris = GetOccupiedTris();\\n\\n        List<v2> validPoints = allPoints.Where(boardPoint => {\\n            List<v2> piecePoints = GetTranslatedPoints(piece, boardPoint);\\n\\n            // must be on the board\\n            if (!piecePoints.All(pt => IsPointOnBoard(pt)))\\n                return false;\\n\\n            // and not overlapping with a placed piece\\n            var verts = piece.windingOrder.Select(ind => BoardPosToWorldPos(piecePoints[ind])).ToList();\\n            var pieceTris = GetTris(verts);\\n\\n            bool overlapping = IsPieceOverlapping(occupiedTris, pieceTris);\\n            return !overlapping;\\n        }).ToList();\\n        return validPoints;\\n    }\\n    v3 GetClosestWorldPoint(Gob piece, List<v2> boardPoints) {\\n        v3 piecePos = piece.Pos();\\n        List<v3> worldPoints = boardPoints.Select(point => BoardPosToWorldPos(point))\\n                                          .OrderBy(point => v3.Distance(piecePos, point))\\n                                          .ToList();\\n        return worldPoints[0];\\n    }\\n    v2 RotatePoint90CW(v2 pt) {\\n        return new v2(pt.y, -pt.x);\\n    }\\n    float Rotate90CW(float rotation) {\\n        rotation += 90f;\\n        if (rotation >= 360f)\\n            rotation = 0f;\\n        return rotation;\\n    }\\n    bool ValidPlacement(Gob piece, out v3 closestWorldPoint) {\\n        List<v2> validPoints = GetValidPoints(piece);\\n        if (validPoints.Count > 0) {\\n            closestWorldPoint = GetClosestWorldPoint(piece, validPoints);\\n            if (v3.Distance(closestWorldPoint, piece.Pos()) < dropDist)\\n                return true;\\n        }\\n        \\n        closestWorldPoint = v3.zero;         \\n        return false;\\n    }\\n\\n    ///////////\\n    // BEHAVIOR\\n    ///////////\\n    void RotatePieceCW(Gob pieceGob, v3 pos, int rotateCount, bool animate=true) {\\n        Piece piece = pieceGob.gc<Piece>();\\n        v2 oldPivot = piece.pivot;\\n        \\n        for (int r = 0; r < rotateCount; r++) {\\n            piece.rotation = Rotate90CW(piece.rotation);\\n            v2 newPivot = RotatePoint90CW(piece.pivot);\\n            piece.points = piece.points.Select(pt => RotatePoint90CW(pt)).ToList();\\n            piece.pivot = newPivot;\\n        }\\n        \\n        // translate\\n        v3 oldPivot3 = new v3(oldPivot.x, 0f, oldPivot.y);\\n        v3 pivot3 = new v3(piece.pivot.x, 0f, piece.pivot.y);\\n        v3 startPos = pieceGob.transform.position;\\n        v3 endPos = startPos + (oldPivot3 - pivot3);\\n        IEnumerator _() {\\n            float t = 0f;\\n            float dur = 0.3f;\\n            while (t < dur) {\\n                float perc = t/dur;\\n                perc = Mathf.Sin (perc * Mathf.PI * 0.5f);\\n\\n                v3 pos = v3.Lerp(startPos, endPos, perc);\\n                pieceGob.transform.position = new v3(pos.x, pieceGob.transform.position.y, pos.z);\\n\\n                t += Time.deltaTime;\\n                yield return new WaitForEndOfFrame();\\n            }\\n            pieceGob.transform.position = endPos;\\n        }\\n        \\n        if (animate)\\n            StartCoroutine(_());\\n        else {\\n            pieceGob.transform.rotation = Quaternion.Euler(0f, piece.rotation, 0f);\\n            endPos.y = pieceGob.transform.position.y;\\n            pieceGob.transform.position = endPos;\\n        }\\n    }\\n    Bounds ReturnPiece(Piece p, bool draw=true, List<Bounds> finalBounds=null) {\\n        p.toPos = p.initPos;\\n        p.lerpPos = true;\\n\\n        // move out radially from center\\n        Gob pieceGob = p.gameObject;\\n        v3 pos = pieceGob.transform.GetChild(0).position;\\n        // v3 pos = pieceGob.Pos();\\n        v3 dir = pos.normalized;\\n        if (dir.magnitude < 1f)\\n            dir = v3.right;\\n\\n        Bounds final = DeintersectPiece(pieceGob, dir, draw, finalBounds);\\n        placedPieces.Remove(p);\\n        return final;\\n    }\\n    Bounds DeintersectPiece(Gob pieceGob, v3 dir, bool draw, List<Bounds> finalBounds) {\\n        // collect bounds\\n        Bounds pieceB = pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().bounds;\\n        List<Bounds> piecesBounds = pieces.Select(pieceGob => pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().bounds).ToList();\\n        if (finalBounds != null)\\n            piecesBounds.AddRange(finalBounds);\\n        piecesBounds.ForEach(bounds => bounds.Expand(0.25f));\\n        \\n        v3 pivotToCenter = pieceB.center-pieceGob.Pos();\\n        pivotToCenter.y = 0f;\\n        v3 center0 = pieceB.center;\\n        pieceB.center = v3.zero;\\n        // bool intersect = boardB.Intersects(pieceB);\\n        v3 delta = dir * 0.1f;\\n        for (int i = 0; i < 1000; i++) {\\n            bool intersect = pieceB.Intersects(boardB) || piecesBounds.Any(pb => pieceB.Intersects(pb));\\n            pieceB = new Bounds(pieceB.center+delta, pieceB.size);\\n            if (!intersect)\\n                break;\\n        }\\n        v3 centerDelta = pieceB.center-center0;\\n        pieceGob.gc<Piece>().toPos = center0 + centerDelta - pivotToCenter; //; //- pieceB.extents;\\n        return pieceB;\\n    }\\n\\n    ///////\\n    // MAIN\\n    ///////\\n    void GameOver() {\\n        canvasGob.On();\\n        gameOver = true;\\n    }\\n    public void OnRestart() {\\n        SceneManager.LoadScene(SceneManager.GetActiveScene().name);\\n    }\\n    public void HardReset() {\\n        PlayerPrefs.DeleteAll();\\n        OnRestart();\\n    }\\n\\n    ///////////////\\n    // UNITY EVENTS\\n    ///////////////\\n    void Awake() {\\n        // get all board points\\n        Piece p = gameObject.gc<Piece>();\\n        p.points = new List<v2>();\\n        for (int i = 0; i < 5; i++) {\\n            for (int j = 0; j < 5; j++) {\\n                p.points.Add(new v2(i,j));\\n            }\\n        }\\n\\n        // get all tris\\n        allTris = new();\\n        List<v2> octCenters = new List<v2>();\\n        for (int i = 0; i < 6; i++) {\\n            for (int j = 0; j < 6; j++) {\\n                octCenters.Add(new v2(1+i*2, 1+j*2));\\n            }\\n        }\\n        octCenters.ForEach(center => {\\n            int cx = Mathf.FloorToInt(center.x);\\n            int cy = Mathf.FloorToInt(center.y);\\n\\n            // top 4\\n            allTris.Add(new() {(cx,cy), (cx-1,cy), (cx-1,cy+1)});\\n            allTris.Add(new() {(cx,cy), (cx-1,cy+1), (cx,cy+1)});\\n            allTris.Add(new() {(cx,cy), (cx,cy+1), (cx+1,cy+1)});\\n            allTris.Add(new() {(cx,cy), (cx+1,cy+1), (cx+1,cy)});\\n\\n            // bot 4\\n            allTris.Add(new() {(cx,cy), (cx-1,cy-1), (cx-1,cy)});\\n            allTris.Add(new() {(cx,cy), (cx,cy-1), (cx-1,cy-1)});\\n            allTris.Add(new() {(cx,cy), (cx+1,cy-1), (cx,cy-1)});\\n            allTris.Add(new() {(cx,cy), (cx+1,cy), (cx+1,cy-1)});\\n        });\\n\\n        // get board bounds\\n        boardB = boardBounds.gc<MeshRenderer>().bounds;\\n        boardB.Expand(1f);\\n\\n        // place pieces\\n        float subangle = Mathf.PI*2f/pieces.Count;\\n        List<int> inds = new();\\n        for (int i = 0; i < pieces.Count; i++) inds.Add(i);\\n        inds.Shuffle();\\n        pieceColors.Shuffle();\\n        for (int i = 0; i < pieces.Count; i++) {\\n            Gob pieceGob = pieces[i];\\n            Piece piece = pieceGob.gc<Piece>();\\n\\n            // place\\n            float theta = subangle*inds[i];\\n            v3 center = new v3(-1f, 0f, -1f);\\n            v3 pos = center + new v3(Mathf.Cos(theta), 0f, Mathf.Sin(theta)) * maxDist;\\n\\n            // rand init rotation\\n            int rotateCount = Mathf.FloorToInt(1f+randf()*4f);\\n            RotatePieceCW(pieceGob, pieceGob.Pos(), rotateCount, false);\\n            \\n            // state init\\n            piece.initPos = pos;\\n            pieceGob.Pos(center);\\n\\n            v3 pivot = new v3(piece.pivot.x, 0f, piece.pivot.y);\\n            piece.childOffset = pieceGob.transform.GetChild(0).localPosition - pivot;\\n            pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color = pieceColors[i].alpha(0.5f);\\n        }\\n\\n        // move pieces outside board\\n        List<Bounds> finals = new List<Bounds>();\\n        pieces.ForEach(pieceGob => {\\n            Piece piece = pieceGob.gc<Piece>();\\n            Bounds final = ReturnPiece(piece, true, finals);\\n            finals.Add(final);\\n        });\\n    }\\n    void Update() {\\n        // reset colors\\n        pieces.ForEach(pieceGob => {\\n            Color c = pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color.alpha(1f);\\n            pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color = c;\\n        });\\n        \\n        // return;\\n        if (gameOver)\\n            return;\\n        \\n        trash.ForEach(e => kill(e));\\n        trash.Clear();\\n\\n        // piece debug\\n        pieces.ForEach(pieceGob => {\\n            // movement dir\\n            Piece piece = pieceGob.gc<Piece>();\\n            Debug.DrawLine(pieceGob.Pos(), piece.toPos, Color.red);\\n            \\n            // bounds\\n            Bounds pieceB = pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().bounds;\\n            DrawBounds(pieceB);\\n\\n            // pivot to center\\n            v3 pivotToCenter = pieceB.center-pieceGob.Pos();\\n            Debug.DrawLine(pieceGob.Pos(), pieceGob.Pos()+pivotToCenter, Color.magenta);\\n        });\\n\\n        // board bounds debug\\n        DrawBounds(boardB);\\n\\n        // lerp piece rotations\\n        pieces.ForEach(pieceGob => {\\n            Piece piece = pieceGob.gc<Piece>();\\n            v3 angles = pieceGob.transform.localEulerAngles;\\n            float smooth = 15f;\\n            pieceGob.transform.rotation = Quaternion.Lerp(pieceGob.transform.rotation, Quaternion.Euler(0f, piece.rotation, 0f), lerpdt(smooth, Time.deltaTime));\\n        });\\n\\n        // lerp piece positions\\n        pieces.ForEach(pieceGob => {\\n            Piece piece = pieceGob.gc<Piece>();\\n            if (piece.lerpPos) {\\n                float smooth = 15f;\\n                pieceGob.transform.position = v3.Lerp(pieceGob.transform.position, piece.toPos, lerpdt(smooth, Time.deltaTime));\\n            }\\n        });\\n\\n        // mouse raycast\\n        Ray r = cam.ScreenPointToRay(Input.mousePosition);\\n        RaycastHit hit;\\n        Physics.Raycast(r, out hit, 1000f, 1 << 3);\\n\\n        // hover\\n        if (selectedPiece != null) {\\n            Color c = selectedPiece.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color.alpha(0.5f);\\n            selectedPiece.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color = c;\\n        }\\n        else if (hit.collider != null) {\\n            Gob pieceGob = hit.collider.gameObject.Parent();\\n            Color c = pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color.alpha(1f);\\n            pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color = c;\\n        }\\n\\n        // select piece\\n        if (Input.GetMouseButtonDown(0) && selectedPiece == null) {\\n            if (hit.collider != null) {\\n                selectedPiece = hit.collider.gameObject.Parent();\\n                selectionOffset = hit.point - selectedPiece.Pos();\\n                selectionOffset.y = 0f;\\n                mouseDownPos = Input.mousePosition;\\n                dragDist = 0f;\\n                Piece piece = selectedPiece.gc<Piece>();\\n                piece.lerpPos = false;\\n                placedPieces.Remove(piece);\\n\\n                // ghost\\n                selectedPieceGhost = make(selectedPiece);\\n                selectedPieceGhost.transform.GetChild(0).gameObject.gc<MeshRenderer>().material = ghostMat;\\n                Color c = selectedPiece.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color.alpha(0.25f);\\n                selectedPieceGhost.transform.GetChild(0).gameObject.gc<MeshRenderer>().material.color = c;\\n                selectedPieceGhost.Off();\\n            }\\n        }\\n        \\n        // drag piece\\n        if (Input.GetMouseButton(0) && selectedPiece != null) {\\n            RaycastHit hit1;\\n            Physics.Raycast(r, out hit1, 1000f, 1 << 6);\\n            if (hit1.collider != null) {\\n                v3 delta = Input.mousePosition - mouseDownPos;\\n                dragDist += delta.magnitude;\\n                mouseDownPos = Input.mousePosition;\\n\\n                // vertical offset\\n                float percMoved = dragDist/Screen.width;\\n                if (percMoved > 0.025f) {\\n                    v3 pos = hit1.point;\\n                    pos.y = 0.5f;\\n                    selectedPiece.Pos(pos - selectionOffset);\\n                }\\n\\n                // ghost\\n                v3 closestWorldPoint = v3.zero;\\n                if (ValidPlacement(selectedPiece, out closestWorldPoint)) {\\n                    selectedPieceGhost.On();\\n                    selectedPieceGhost.Pos(closestWorldPoint);\\n                }\\n                else {\\n                    selectedPieceGhost.Off();\\n                }\\n            }\\n        }\\n\\n        // mouse up\\n        if (Input.GetMouseButtonUp(0) && selectedPiece != null) {\\n            Piece piece = selectedPiece.gc<Piece>();\\n            float percMoved = dragDist/Screen.width;\\n\\n            // rotate piece\\n            if (percMoved < 0.05f) {\\n                // return if placed\\n                v3 closestPoint = v3.zero;\\n                if (ValidPlacement(selectedPiece, out closestPoint))\\n                    ReturnPiece(piece);\\n\\n                // rotate                \\n                else\\n                   RotatePieceCW(selectedPiece, selectedPiece.gc<Piece>().initPos, 1);\\n\\n                // deselect\\n                selectedPiece = null;\\n\\n                // ghost\\n                kill(selectedPieceGhost);\\n                selectedPieceGhost = null;\\n            }\\n\\n            // drop piece\\n            else {\\n                List<v2> validPoints = GetValidPoints(selectedPiece);\\n                bool validDrop = false;\\n                if (validPoints.Count > 0) {\\n                    v3 closestWorldPoint = GetClosestWorldPoint(selectedPiece, validPoints);\\n                    if (v3.Distance(closestWorldPoint, selectedPiece.Pos()) < dropDist)\\n                        validDrop = true;\\n                }\\n\\n                // drop if there's room\\n                if (validDrop) {\\n                    v3 closestWorldPoint = GetClosestWorldPoint(selectedPiece, validPoints);\\n                    selectedPiece.Pos(closestWorldPoint);\\n                    placedPieces.Add(selectedPiece.gc<Piece>());\\n\\n                    // move back down\\n                    v3 childPos = selectedPiece.transform.GetChild(0).localPosition;\\n                    childPos.y = 0f;\\n                    selectedPiece.transform.GetChild(0).localPosition = childPos;\\n                }\\n\\n                // return to pickup pos\\n                else\\n                    ReturnPiece(piece);\\n\\n                // deselect\\n                selectedPiece = null;\\n\\n                // ghost\\n                kill(selectedPieceGhost);\\n                selectedPieceGhost = null;\\n\\n                // check for win\\n                if (placedPieces.Count == 7)\\n                    GameOver();\\n            }\\n        }\\n    }\\n    void LateUpdate() {\\n        // get bounds around board and all pieces\\n        Bounds superBounds = gameOver ? boardBounds.gc<MeshRenderer>().bounds\\n                                      : boardB;\\n        if (!gameOver) {\\n            pieces.ForEach(pieceGob => {\\n                Bounds pb = pieceGob.transform.GetChild(0).gameObject.gc<MeshRenderer>().bounds;\\n                superBounds.Encapsulate(pb);\\n            });\\n            superBounds.Expand(1f);\\n        }\\n        else\\n            superBounds.Expand(-1f);\\n        DrawBounds(superBounds);\\n\\n        float smooth = 15f;\\n        \\n        // lerp cam pos\\n        v3 center = superBounds.center;\\n        v3 camPos = cam.gameObject.Pos();\\n        camPos.x = center.x;\\n        camPos.z = center.z;\\n        cam.gameObject.Pos(v3.Lerp(cam.gameObject.Pos(), camPos, lerpdt(smooth, Time.deltaTime)));\\n\\n        // lerp cam size\\n        v3 extents = superBounds.extents;\\n        float camHeight = extents.x > extents.z ? extents.x * (Screen.height/Screen.width)\\n                                               : extents.z;\\n        cam.orthographicSize = Mathf.Lerp(cam.orthographicSize, camHeight, lerpdt(smooth, Time.deltaTime));\\n    }\\n}\",\"selection\":{\"ranges\":[{\"anchor\":10008,\"head\":10008}],\"main\":0},\"fold\":[695,1064,1474,1524,1581,2298,2340,2404,2446,2540,2587,2671,2713,2879,2928,2994,3056,3201,3255,3564,3664,3921,3968,4356,4416,4491,4536,5310,5374,5674,5707,5748,5788,5900,5964,6322,6455,7901,7983,8439,8529,9633,9693,9747,9778,9851,9882,9941,10022,12762,12783,19577,19602,20764]}";