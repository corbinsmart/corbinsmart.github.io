export default ":- use_module(library(clpfd)).\r\n\r\nsmallint(X) :- X in 1..20.\r\n\r\nsmallints(X, Y, Z) :-\r\n  smallint(X),\r\n  smallint(Y),\r\n  smallint(Z).\r\n\r\nplus(X, Y, Z) :-\r\n    smallints(X, Y, Z),\r\n    X + Y #= Z.\r\n\r\nminus(X, Y, Z) :-\r\n    smallints(X, Y, Z),\r\n    X - Y #= Z.\r\n\r\ndiv(X, Y, Z) :-\r\n    smallints(X, Y, Z),\r\n    X // Y #= Z.\r\n    \r\nmult(X, Y, Z) :-\r\n    smallints(X, Y, Z),\r\n    X * Y #= Z.";