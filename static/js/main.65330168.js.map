export default "{\"doc\":\":- use_module(library(clpfd)).\\n\\nsmallint(X) :- X in 1..100.\\n\\nsmallints(X, Y, Z) :-\\n  smallint(X),\\n  smallint(Y),\\n  smallint(Z).\\n\\nplus(X, Y, Z) :-\\n    smallints(X, Y, Z),\\n    X + Y #= Z.\\n\\nminus(X, Y, Z) :-\\n    smallints(X, Y, Z),\\n    X - Y #= Z.\\n\\ndiv(X, Y, Z) :-\\n    smallints(X, Y, Z),\\n    X // Y #= Z.\\n    \\nmult(X, Y, Z) :-\\n    smallints(X, Y, Z),\\n    X * Y #= Z.\",\"selection\":{\"ranges\":[{\"anchor\":59,\"head\":59}],\"main\":0},\"fold\":[]}";